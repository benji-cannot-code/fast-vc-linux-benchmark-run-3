kapi := arch/$(ARCH)/include/generated/asm
kapi-hdrs-y := $(kapi)/facility-defs.h $(kapi)/dis-defs.h

PHONY += kapi

kapi:	$(kapi-hdrs-y)

hostprogs		    += gen_facilities
