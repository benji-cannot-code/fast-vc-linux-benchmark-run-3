# create a compressed vmlinux image from the original vmlinux
#

targets		:= vmlinux head.o misc.o piggy.o vmlinux.lds
asflags-y	:=

/* bench 24034.0.0 2756e1631064 */
/* bench 24034.0.1 21b052466659 */
/* bench 24034.0.2 4221eaf5c3cf */
/* bench 24034.0.3 0d3974f69f3a */
/* bench 24034.0.4 814526a30b29 */
/* bench 24034.0.5 27fb4f592874 */
/* bench 24034.0.6 36c6d7462825 */
/* bench 24034.0.7 2b234f6a21d5 */

$(obj)/vmlinux: $(obj)/vmlinux.lds $(OBJECTS) $(obj)/piggy.o FORCE
	$(call if_changed,ld)

LDFLAGS_piggy.o := -r --format binary --oformat elf32-littlenios2 -T

$(obj)/piggy.o: $(obj)/vmlinux.scr $(obj)/../vmlinux.gz FORCE
	$(call if_changed,ld)
