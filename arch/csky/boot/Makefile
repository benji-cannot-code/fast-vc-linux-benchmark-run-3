$(obj)/zImage:  $(obj)/Image FORCE
	$(call if_changed,$(compress-y))
	@echo '  Kernel: $@ is ready'

UIMAGE_ARCH		= sandbox
UIMAGE_COMPRESSION	= $(compress-y)
UIMAGE_LOADADDR		= $(shell $(NM) vmlinux | awk '$$NF == "_start" {print $$1}')

$(obj)/uImage: $(obj)/zImage
	$(call if_changed,uimage)
	@echo 'Image: $@ is ready'
