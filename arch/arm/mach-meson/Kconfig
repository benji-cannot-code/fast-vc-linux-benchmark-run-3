menuconfig ARCH_MESON
	bool "Amlogic Meson SoCs"
	depends on ARCH_MULTI_V7
	select GPIOLIB
	select GENERIC_IRQ_CHIP
	select ARM_GIC
	select ARM_GLOBAL_TIMER
	select CACHE_L2X0
	select PINCTRL
	select PINCTRL_MESON
	select HAVE_ARM_SCU if SMP
	select HAVE_ARM_TWD if SMP

