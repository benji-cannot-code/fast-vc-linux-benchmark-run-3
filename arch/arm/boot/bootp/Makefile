GCOV_PROFILE	:= n

LDFLAGS_bootp	:= --no-undefined -X \
		 --defsym initrd_phys=$(INITRD_PHYS) \
		 --defsym params_phys=$(PARAMS_PHYS) -T
AFLAGS_initrd.o :=-DINITRD=\"$(INITRD)\"
/* bench 16388.1.0 51d56fbdb951 */
/* bench 16388.1.1 fd66ce0f9374 */
/* bench 16388.1.2 fcd8d833430b */
targets	:= bootp init.o kernel.o initrd.o

/* bench 15781.0.0 34145106c483 */
# Note that bootp.lds picks up kernel.o and initrd.o
$(obj)/bootp:	$(src)/bootp.lds $(addprefix $(obj)/,init.o kernel.o initrd.o) FORCE
	$(call if_changed,ld)
