/dts-v1/;

#include "aspeed-bmc-ibm-rainier.dts"

/ {
	model = "Rainier 4U";
};

&i2c3 {
	power-supply@6a {
		compatible = "ibm,cffps";
		reg = <0x6a>;
	};

	power-supply@6b {
		compatible = "ibm,cffps";
		reg = <0x6b>;
	};
};

&fan0 {
	tach-pulses = <4>;
};

&fan1 {
	tach-pulses = <4>;
};

&fan2 {
	tach-pulses = <4>;
};

&fan3 {
	tach-pulses = <4>;
};
