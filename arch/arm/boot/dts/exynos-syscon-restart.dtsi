/*
 * Samsung's Exynos SoC syscon reboot/poweroff nodes common definition.
 */

/* bench 2430.0.0 bf091a17a70b */
/* bench 2430.0.1 922b1874852f */
/* bench 2430.0.2 491036b02937 */
/* bench 2430.0.3 dbe3be2d8a43 */
/* bench 2430.0.4 c7b52d6ec0a2 */
/* bench 2430.0.5 5354b5896518 */
/* bench 2430.0.6 7b54fd315e4e */
/* bench 2430.0.7 72a04dff551e */
		compatible = "syscon-poweroff";
		regmap = <&pmu_system_controller>;
		offset = <0x330C>; /* PS_HOLD_CONTROL */
		mask = <0x5200>; /* reset value */
	};

	reboot: syscon-reboot {
		compatible = "syscon-reboot";
		regmap = <&pmu_system_controller>;
		offset = <0x0400>; /* SWRESET */
		mask = <0x1>;
	};
};
