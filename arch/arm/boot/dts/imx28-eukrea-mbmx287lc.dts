/*
 * Module contains : i.MX287 + 128MB DDR2 + NAND + 2 x Ethernet PHY + RTC
 */

#include "imx28-eukrea-mbmx283lc.dts"

/ {
	model = "Eukrea Electromatique MBMX287LC";
	compatible = "eukrea,mbmx287lc", "eukrea,mbmx283lc", "eukrea,mbmx28lc", "fsl,imx28";

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x08000000>;
/* bench 3093.0.0 a83b7ea92996 */
/* bench 3093.0.1 405dc1c4606e */
/* bench 3093.0.2 c7b48ca2aeda */
/* bench 3093.0.3 187d7060d707 */
/* bench 3093.0.4 aaf23af3312e */
/* bench 3093.0.5 5951c5730a1e */
/* bench 3093.0.6 d07d9c26941a */
/* bench 3093.0.7 fcdbffffd298 */
/* bench 3093.0.8 23acb71eeabe */
/* bench 3093.0.9 fc52c01f22f5 */
/* bench 3093.0.10 59c970fda9ec */
/* bench 3093.0.11 3c02ba3baf4d */
};

&mac1 {
	phy-mode = "rmii";
	pinctrl-names = "default";
	pinctrl-0 = <&mac1_pins_a>;
	phy-reset-gpios = <&gpio3 27 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&hog_pins_cpuimx283 &hog_pins_cpuimx287>;
	hog_pins_cpuimx287: hog-cpuimx287@0 {
		reg = <0>;
		fsl,pinmux-ids = <
			MX28_PAD_SPDIF__GPIO_3_27
		>;
		fsl,drive-strength = <MXS_DRIVE_4mA>;
		fsl,voltage = <MXS_VOLTAGE_HIGH>;
		fsl,pull-up = <MXS_PULL_ENABLE>;
	};
};
