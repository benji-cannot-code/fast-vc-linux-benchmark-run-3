	gpio_poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
	};

};

&mdio {
	status = "okay";

	ethphy0: ethernet-phy@X {
                /* overwrite reg property in board file */
	};
};

&eth0 {
	status = "okay";
	ethernet0-port@0 {
		phy-handle = <&ethphy0>;
	};
