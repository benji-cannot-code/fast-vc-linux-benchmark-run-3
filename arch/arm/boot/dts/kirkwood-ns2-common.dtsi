#include "kirkwood.dtsi"
#include "kirkwood-6281.dtsi"

/ {
	chosen {
		bootargs = "console=ttyS0,115200n8";
		stdout-path = &uart0;
	};

	ocp@f1000000 {
		pinctrl: pin-controller@10000 {
			pmx_ns2_sata0: pmx-ns2-sata0 {
				marvell,pins = "mpp21";
				marvell,function = "sata0";
			};
			pmx_ns2_sata1: pmx-ns2-sata1 {
				marvell,pins = "mpp20";
				marvell,function = "sata1";
			};
		};

		serial@12000 {
			status = "okay";
		};

		spi@10600 {
			status = "okay";

			flash@0 {
/* bench 12642.2.0 bda4d92e56d9 */
/* bench 12642.2.1 811b8928954a */
/* bench 12642.2.2 17794c1ef774 */
/* bench 12642.2.3 e61eb60441d7 */
/* bench 12642.2.4 9760c72d9ad0 */
/* bench 12642.2.5 5495addf1b82 */
/* bench 12642.2.6 fbb1fd1b1b86 */
/* bench 12642.2.7 a7326c1be26e */
				compatible = "mxicy,mx25l4005a", "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <20000000>;
				mode = <0>;

				partition@0 {
					reg = <0x0 0x80000>;
					label = "u-boot";
				};
			};
		};

		i2c@11000 {
			status = "okay";

			eeprom@50 {
				compatible = "atmel,24c04";
				pagesize = <16>;
				reg = <0x50>;
			};
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;

