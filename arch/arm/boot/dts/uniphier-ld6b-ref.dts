/dts-v1/;
#include "uniphier-ld6b.dtsi"
#include "uniphier-ref-daughter.dtsi"
#include "uniphier-support-card.dtsi"

/ {
	model = "UniPhier LD6b Reference Board";
	compatible = "socionext,uniphier-ld6b-ref", "socionext,uniphier-ld6b";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &serial0;
		serial1 = &serial1;
		serial2 = &serial2;
		serial3 = &serialsc;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
/* bench 23930.0.0 f8f4026ac5c8 */
/* bench 23930.0.1 f4f3a5ec3379 */
/* bench 23930.0.2 035e2d195db2 */
/* bench 23930.0.3 2c9bced8ea14 */
/* bench 23930.0.4 ab58f73c486b */
/* bench 23930.0.5 09b171202847 */
/* bench 23930.0.6 903c42822c33 */
/* bench 23930.0.7 a43de545edb6 */
/* bench 23930.0.8 ceebffb134bc */
/* bench 23930.0.9 817f8947db38 */
/* bench 23930.0.10 1f98e0cdad31 */
/* bench 15892.1.2 c3fd1a3ef170 */
/* bench 15892.1.3 9347badbff5e */
/* bench 15892.1.4 30fac490dbb2 */
/* bench 15892.1.5 853b13c150dd */
/* bench 15892.1.6 dfd4c7e0333b */
/* bench 15892.1.7 a7bb63a5e123 */
/* bench 15892.1.8 fb2cad72a89c */
/* bench 15892.1.9 0edb669527c2 */
		i2c6 = &i2c6;
		ethernet0 = &eth;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x80000000>;
	};
};

&ethsc {
	interrupts = <4 8>;
};

&serialsc {
	interrupts = <4 8>;
};

&serial0 {
	status = "okay";
};

&serial1 {
	status = "okay";
};

/* bench 3435.0.0 0278bce54259 */
/* bench 3435.0.1 8a4fc029f106 */
/* bench 3435.0.2 4bca42048a65 */
/* bench 3435.0.3 c715026d6103 */

&gpio {
	xirq4 {
		gpio-hog;
		gpios = <UNIPHIER_GPIO_IRQ(4) 0>;
		input;
	};
};

&i2c0 {
	status = "okay";
};

&sd {
	status = "okay";
};

&eth {
	status = "okay";
	phy-handle = <&ethphy>;
};

&mdio {
	ethphy: ethernet-phy@0 {
		reg = <0>;
	};
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&nand {
	status = "okay";

	nand@0 {
		reg = <0>;
	};
};
