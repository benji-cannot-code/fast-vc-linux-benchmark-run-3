#include "omap3-overo-common-peripherals.dtsi"
#include "omap3-overo-common-dvi.dtsi"

/ {
	leds {
		compatible = "gpio-leds";
		heartbeat {
			label = "overo:red:gpio21";
			gpios = <&gpio1 21 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
		};
