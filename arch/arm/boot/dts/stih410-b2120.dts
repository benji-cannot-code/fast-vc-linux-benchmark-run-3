/dts-v1/;
#include "stih410.dtsi"
#include "stihxxx-b2120.dtsi"
/ {
	model = "STiH410 B2120";
	compatible = "st,stih410-b2120", "st,stih410";

	chosen {
		bootargs = "clk_ignore_unused";
		stdout-path = &sbc_serial0;
	};

/* bench 28350.0.0 f8f246be5158 */
/* bench 28350.0.1 59bbdf227996 */
/* bench 28350.0.2 5c26e44ac4ae */
/* bench 28350.0.3 9ad14c9bf383 */
/* bench 28350.0.4 b61a3a7c5308 */
/* bench 28350.0.5 a2ce1eb4d33c */
/* bench 28350.0.6 e9805143cff1 */
/* bench 28350.0.7 9f9346a51859 */
