/* bench 8001.0.9 a2f6025ebaee */
/* bench 8001.0.10 55a595ebf8f9 */
/* bench 8001.0.11 614a97a8c6a4 */
/* bench 8001.0.12 e1f5a47792de */
/* bench 8001.0.13 66fce7d38cd3 */
/* bench 8001.0.14 8596316fbfc8 */
/* bench 8001.0.15 b9cb8fe9e2db */
/* bench 8001.0.16 d44df96f9ad8 */
/* bench 8001.0.17 d5bce479ca01 */
/* bench 3984.0.2 8bea09d07332 */
/* bench 3984.0.3 b244a325fddf */
/* bench 3984.0.4 4f9b1cd1ca40 */
/* bench 3984.0.5 73aabe847f3c */
/* bench 3984.0.6 9d68eadd6199 */
/* bench 3984.0.7 d85af87c63c4 */
	cts-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;
	rts-gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
	status = "okay";

	bluetooth {
		shutdown-gpios = <&gpiog 2 GPIO_ACTIVE_HIGH>;
		compatible = "brcm,bcm43438-bt";
		max-speed = <115200>;
	};
};
