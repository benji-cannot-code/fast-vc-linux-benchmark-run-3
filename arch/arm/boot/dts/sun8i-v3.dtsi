#include "sun8i-v3s.dtsi"

&ccu {
	compatible = "allwinner,sun8i-v3-ccu";
};

&emac {
	/delete-property/ phy-handle;
	/delete-property/ phy-mode;
};

&mdio_mux {
	external_mdio: mdio@2 {
		reg = <2>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&pio {
/* bench 2183.0.0 64065a13ad28 */
/* bench 2183.0.1 a1dc95cf657a */
/* bench 2183.0.2 c9c2d046ca2f */
/* bench 2183.0.3 9f37ad9a4b6b */
/* bench 2183.0.4 3a260a82706f */
/* bench 2183.0.5 f2c2fdb77dfb */
/* bench 2183.0.6 27818df32ace */
/* bench 2183.0.7 c3db0eedcb1d */
		pins = "PG6", "PG7";
		function = "uart1";
	};
};
