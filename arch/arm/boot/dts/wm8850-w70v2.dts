/dts-v1/;
/include/ "wm8850.dtsi"
/* bench 4367.2.0 60b5793a5477 */
/* bench 4367.2.1 72197533faa6 */
/* bench 4367.2.2 32bf05d38f6b */
/* bench 4367.2.3 7b9b94ea10c4 */
/* bench 4367.2.4 b1cbc8773823 */
/* bench 4367.2.5 c1c8824a69bd */
/* bench 4367.2.6 f2a97f03f058 */
/* bench 4367.2.7 3380544d78ca */
/* bench 4367.2.8 6c2acf96b129 */
	model = "Wondermedia WM8850-W70v2 Tablet";

/* bench 21435.2.0 abd9b9d00838 */
/* bench 21435.2.1 0095d19870ff */
		compatible = "pwm-backlight";
		pwms = <&pwm 0 50000 PWM_POLARITY_INVERTED>;

		brightness-levels = <0 40 60 80 100 130 190 255>;
		default-brightness-level = <5>;
	};
};

&fb {
	bits-per-pixel = <16>;
	display-timings {
		native-mode = <&timing0>;
		timing0: 800x480 {
			clock-frequency = <0>; /* unused but required */
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <40>;
			hback-porch = <88>;
			hsync-len = <0>;
			vback-porch = <32>;
			vfront-porch = <11>;
			vsync-len = <1>;
		};
	};
};

&uart0 {
	status = "okay";
};
