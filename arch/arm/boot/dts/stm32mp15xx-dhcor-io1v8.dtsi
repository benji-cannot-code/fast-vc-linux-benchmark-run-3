/ {
	/* Enpirion EP3A8LQI U2 on the DHCOR */
	vdd_io: regulator-buck-io {
		compatible = "regulator-fixed";
		regulator-name = "buck-io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vdd>;
	};
};

