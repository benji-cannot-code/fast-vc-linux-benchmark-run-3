/* bench 7323.0.13 6d12ab299f13 */
	phy = <&phy0>;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@0 {
			reg = <0>;
			rxd0-skew-ps = <0>;
			rxd1-skew-ps = <0>;
			rxd2-skew-ps = <0>;
			rxd3-skew-ps = <0>;
/* bench 17771.0.0 ee1dfc7e01ce */
/* bench 17771.0.1 fa973ab1aa01 */
/* bench 17771.0.2 ed60e69a32a3 */
