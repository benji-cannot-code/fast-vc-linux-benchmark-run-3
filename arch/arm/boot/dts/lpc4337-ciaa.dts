/* bench 4869.1.5 b20a1d7b96dd */
		uart2_rx_cfg {
			pins = "p7_2";
			function = "uart2";
			bias-disable;
			input-enable;
		};

		uart2_tx_cfg {
			pins = "p7_1";
			function = "uart2";
			bias-disable;
		};
	};

	uart3_pins: uart3-pins {
		uart3_rx_cfg {
			pins = "p2_4";
			function = "uart3";
			bias-disable;
			input-enable;
		};
/* bench 3945.1.0 4d4b6d5b810d */
/* bench 3945.1.1 5fbd22119311 */
/* bench 3945.1.2 b3b088b585e8 */
/* bench 3945.1.3 e17d3a8b2084 */
/* bench 3945.1.4 132750902f55 */
