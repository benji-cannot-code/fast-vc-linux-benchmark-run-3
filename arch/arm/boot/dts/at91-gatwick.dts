	status = "okay";
};

&spi1 {
	status = "okay";

	spidev@0 {
		compatible = "semtech,sx1301";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

&usb1 {
	status = "okay";
	/delete-property/atmel,oc-gpio;
};

&usb2 {
	status = "okay";
};
