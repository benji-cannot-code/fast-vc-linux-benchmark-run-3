/dts-v1/;
/include/ "sun8i-a23.dtsi"

/ {
	model = "Ippo Q8H Dual Core Tablet (v5)";
	compatible = "ippo,q8h-v5", "allwinner,sun8i-a23";

	chosen {
		bootargs = "earlyprintk console=ttyS0,115200";
	};

	soc@01c00000 {
		r_uart: serial@01f02800 {
			status = "okay";
		};
	};
};
