/dts-v1/;

/include/ "omap3.dtsi"

/ {
	model = "TI OMAP3 EVM (OMAP3530, AM/DM37x)";
	compatible = "ti,omap3-evm", "ti,omap3";

	memory {
		device_type = "memory";
		reg = <0x80000000 0x10000000>; /* 256 MB */
	};
};
