				pins = "gpio12", "gpio13";
				function = "gsbi4";
				bias-disable;
			};

			buttons_pins: buttons_pins {
				mux {
					pins = "gpio54", "gpio65";
					drive-strength = <2>;
					bias-pull-up;
				};
			};
		};

		gsbi@16300000 {
			i2c@16380000 {
				status = "okay";
				clock-frequency = <200000>;
				pinctrl-0 = <&i2c4_pins>;
				pinctrl-names = "default";
			};
		};
	};
};
