#include "qcom-ipq8064-v1.0.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ8064/AP-148";
	compatible = "qcom,ipq8064-ap148";

/* bench 318.1.0 bfa4875293da */
/* bench 318.1.1 0f1b421e0ede */
/* bench 318.1.2 b37a8b412b16 */
/* bench 318.1.3 3cb6cb1dd8fa */
/* bench 318.1.4 a73d20c26412 */
/* bench 318.1.5 410dc66d425a */
/* bench 318.1.6 37d0e75566c4 */
/* bench 318.1.7 caa1f06652db */
