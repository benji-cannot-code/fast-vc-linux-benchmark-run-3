/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Xilinx ZC770 XM012 board";
	compatible = "xlnx,zynq-zc770-xm012", "xlnx,zynq-7000";

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
/* bench 10243.0.0 d6ca54cae476 */
/* bench 10243.0.1 a1274ab3c1e4 */
/* bench 10243.0.2 36b38c5cb4fc */
/* bench 10243.0.3 0903daef3844 */
/* bench 10243.0.4 0ac2f69b7e42 */
/* bench 10243.0.5 1425c5f2a1a0 */
/* bench 10243.0.6 22924db681f8 */
/* bench 10243.0.7 125788c61fae */
/* bench 10243.0.8 403c67217b1f */
/* bench 10243.0.9 56b6324ae23a */
/* bench 10243.0.10 222e31889ef4 */
		serial0 = &uart1;
		spi0 = &spi1;
	};

	chosen {
		bootargs = "";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};
};

&can1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	eeprom0: eeprom@52 {
		compatible = "atmel,24c02";
		reg = <0x52>;
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	eeprom1: eeprom@52 {
		compatible = "atmel,24c02";
		reg = <0x52>;
	};
};

&spi1 {
	status = "okay";
	num-cs = <4>;
	is-decoded-cs = <0>;
};

&uart1 {
	status = "okay";
};
