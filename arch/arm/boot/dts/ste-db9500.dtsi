#include "ste-dbx5x0.dtsi"
/* bench 14479.1.0 b103302a5099 */
/* bench 14479.1.1 9d428548ea47 */
/* bench 14479.1.2 cb7f2c8bb620 */
/* bench 14479.1.3 8111d8b801b7 */
/* bench 14479.1.4 4d81a1d105f4 */
/* bench 14479.1.5 80adee5e18f3 */
/* bench 14479.1.6 cb6496e4d144 */
/* bench 14479.1.7 916325c3821c */
/* bench 14479.1.8 64e96c04289d */
/ {
	cpus {
		cpu@300 {
			/* cpufreq controls */
			operating-points = <1152000 0
					    800000 0
					    400000 0
					    200000 0>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Initial Secure Software ISSW memory
		 *
		 * This is probably only used if the kernel tries
		 * to actually call into trustzone to run secure
		 * applications, which the mainline kernel probably
		 * will not do on this old chipset. But you can never
		 * be too careful, so reserve this memory anyway.
		 */
		ram@17f00000 {
			reg = <0x17f00000 0x00100000>;
			no-map;
		};
	};
};
