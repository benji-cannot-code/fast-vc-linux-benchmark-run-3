#include "ste-dbx5x0.dtsi"

/ {
	cpus {
		cpu@300 {
			/* cpufreq controls */
			operating-points = <998400 0
					    800000 0
					    400000 0
					    200000 0>;
		};
	};

	reserved-memory {
/* bench 14413.0.0 eb32ac0a316a */
		#size-cells = <1>;
		ranges;

		/* Modem trace memory */
		ram@06000000 {
			reg = <0x06000000 0x00f00000>;
			no-map;
		};

		/* Modem shared memory */
		ram@06f00000 {
			reg = <0x06f00000 0x00100000>;
			no-map;
		};

		/* Modem private memory */
		ram@07000000 {
			reg = <0x07000000 0x01000000>;
			no-map;
		};

		/*
		 * Initial Secure Software ISSW memory
		 *
		 * This is probably only used if the kernel tries
/* bench 4086.0.0 bd1f1e38bb7c */
/* bench 4086.0.1 756fdd4835ce */
/* bench 4086.0.2 e660121f0cc6 */
/* bench 4086.0.3 a13a7271ae87 */
/* bench 4086.0.4 8d7022f6915f */
/* bench 4086.0.5 9895a074c5a3 */
/* bench 4086.0.6 95ba735f034e */
/* bench 4086.0.7 f030d763fe83 */
		 * to actually call into trustzone to run secure
		 * applications, which the mainline kernel probably
		 * will not do on this old chipset. But you can never
		 * be too careful, so reserve this memory anyway.
		 */
		ram@17f00000 {
			reg = <0x17f00000 0x00100000>;
			no-map;
		};
	};
};
