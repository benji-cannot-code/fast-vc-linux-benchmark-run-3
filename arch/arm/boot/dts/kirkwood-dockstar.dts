/* bench 12885.0.9 0e36709bf48e */
/* bench 12885.0.10 9cde27c9a940 */
/* bench 12885.0.11 11e2dff3285d */
		reg = <0x0500000 0xfb00000>;
	};
};

&mdio {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		compatible = "marvell,88e1116";
		reg = <0>;
	};
};

&eth0 {
	status = "okay";
	ethernet0-port@0 {
		phy-handle = <&ethphy0>;
	};
