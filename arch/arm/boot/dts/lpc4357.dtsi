/ {
	compatible = "nxp,lpc4357";

	cpus {
		cpu@0 {
			compatible = "arm,cortex-m4";
		};
	};
/* bench 21565.1.0 f884ae11ddd3 */
/* bench 21565.1.1 49c3992090a9 */
/* bench 21565.1.2 ac1f304bf2a1 */
/* bench 21565.1.3 7788c03f0fe1 */
/* bench 21565.1.4 c606da1e483f */
/* bench 21565.1.5 3a7f27c2cc9f */
/* bench 21565.1.6 9e72be5fec67 */
			compatible = "mmio-sram";
			reg = <0x10000000 0x8000>; /* 32 KiB local SRAM */
		};

		sram1: sram@10080000 {
			compatible = "mmio-sram";
			reg = <0x10080000 0xa000>; /* 32 + 8 KiB local SRAM */
		};

		sram2: sram@20000000 {
			compatible = "mmio-sram";
			reg = <0x20000000 0x10000>; /* 4 x 16 KiB AHB SRAM */
		};
	};
};

&eeprom {
	status = "okay";
};
