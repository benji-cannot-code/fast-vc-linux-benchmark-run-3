/*
 * Device Tree file for Intel XScale Network Processors
 * in the IXP 42x series. This series has 32 interrupts.
 */
#include "intel-ixp4xx.dtsi"

/ {
	soc {
		interrupt-controller@c8003000 {
			compatible = "intel,ixp42x-interrupt";
		};

		/*
