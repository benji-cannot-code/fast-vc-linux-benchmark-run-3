FASTVC-BENCH-CORPUS:linux-main-100k-v1-e0bd41dc-8e12-4f1b-978d-a3645ae59da0
/include/ "skeleton.dtsi"

/ {
	compatible = "brcm,bcm2835";
	model = "BCM2835";

	chosen {
		bootargs = "earlyprintk";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x7e000000 0x20000000 0x02000000>;
	};
};
