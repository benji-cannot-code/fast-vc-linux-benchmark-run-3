&i2c2 {
	clock-frequency = <100000>;
	status = "okay";

	eeprom: eeprom@50 {
		compatible = "atmel,24c08";
		reg = <0x50>;
		status = "okay";
	};

	atecc508a@60 {
		compatible = "atmel,atecc508a";
		reg = <0x60>;
	};
};

&can0 {
	pinctrl-names = "default";
	pinctrl-0 = <&can_ph_pins>;
	status = "okay";
};
