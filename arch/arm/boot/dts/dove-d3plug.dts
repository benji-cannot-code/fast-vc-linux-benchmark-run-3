/* bench 1144.1.6 d20650696416 */
/* bench 1144.1.7 0d6a84fbbad6 */
/* bench 1144.1.8 ea356c8ef0db */
			regulator-max-microvolt = <5000000>;
			enable-active-high;
			regulator-always-on;
			regulator-boot-on;
			gpio = <&gpio0 8 0>;
			pinctrl-0 = <&pmx_gpio_8>;
			pinctrl-names = "default";
		};
	};
};
