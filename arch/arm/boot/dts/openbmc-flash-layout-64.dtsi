partitions {
	compatible = "fixed-partitions";
	#address-cells = <1>;
	#size-cells = <1>;

	u-boot@0 {
		reg = <0x0 0x60000>; // 384KB
		label = "u-boot";
	};

	u-boot-env@60000 {
		reg = <0x60000 0x20000>; // 128KB
		label = "u-boot-env";
	};

	kernel@80000 {
		reg = <0x80000 0x500000>; // 5MB
		label = "kernel";
	};

	rofs@580000 {
		reg = <0x580000 0x2a80000>; // 42.5MB
		label = "rofs";
	};

	rwfs@3000000 {
		reg = <0x3000000 0x1000000>; // 16MB
		label = "rwfs";
	};
};
