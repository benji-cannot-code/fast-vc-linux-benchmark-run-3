&sdio {
	status = "okay";
};

&pinctrl {
	compatible = "marvell,98dx4251-pinctrl";

	sdio_pins: sdio-pins {
		marvell,pins = "mpp5", "mpp6", "mpp7",
			       "mpp8", "mpp9", "mpp10";
		marvell,function = "sd0";
	};
};

&pp0 {
	compatible = "marvell,prestera-98dx4251", "marvell,prestera";
	interrupts = <33>, <34>, <35>, <36>;
};
