&system_bus {
	status = "okay";
	ranges = <1 0x00000000 0x42000000 0x02000000>;
	interrupt-parent = <&gpio>;

/* bench 5642.1.0 42670aa23920 */
/* bench 5642.1.1 b5ff361fb6bd */
/* bench 5642.1.2 1d6d54599ab0 */
/* bench 5642.1.3 33cefaddc933 */
/* bench 5642.1.4 9d32d2c940d3 */
/* bench 5642.1.5 26b09039fb60 */
/* bench 5642.1.6 13baf6abc54c */
/* bench 5642.1.7 b892aaa31c81 */
/* bench 5642.1.8 75c6162ad01f */
/* bench 5642.1.9 151289913ea4 */
/* bench 5642.1.10 3b94951f63f9 */
		compatible = "smsc,lan9118", "smsc,lan9115";
		reg = <1 0x01f00000 0x1000>;
		phy-mode = "mii";
		reg-io-width = <4>;
	};

	serialsc: serial@1,1fb0000 {
		compatible = "ns16550a";
		reg = <1 0x01fb0000 0x20>;
		clock-frequency = <12288000>;
		reg-shift = <1>;
	};
};
