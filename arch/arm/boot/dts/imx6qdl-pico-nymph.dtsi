&i2c2 {
	io-expander@25 {
		compatible = "nxp,pca9554";
		reg = <0x25>;
		gpio-controller;
		#gpio-cells = <2>;
		#interrupt-cells = <2>;
	};
};

&i2c3 {
	rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
	};
};

&pcie {
	status = "okay";
};

&iomuxc {
	pinctrl_gpio_leds: gpioledsgrp {
		fsl,pins = <
			MX6QDL_PAD_CSI0_DAT13__GPIO5_IO31	0x1b0b0
		>;
	};
};
