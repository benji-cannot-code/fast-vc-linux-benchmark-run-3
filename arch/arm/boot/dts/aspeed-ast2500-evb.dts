/dts-v1/;

#include "aspeed-g5.dtsi"

/ {
	model = "AST2500 EVB";
	compatible = "aspeed,ast2500";

/* bench 23483.0.0 9164fecac8cc */
/* bench 23483.0.1 3de64de5a057 */
/* bench 23483.0.2 9ba535adc9aa */
/* bench 23483.0.3 e1577a8f088c */
/* bench 23483.0.4 7b5209092b80 */
/* bench 23483.0.5 49d5f56b8cc5 */
