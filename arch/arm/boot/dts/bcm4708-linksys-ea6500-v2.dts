/dts-v1/;

#include "bcm4708.dtsi"
#include "bcm5301x-nand-cs0-bch8.dtsi"

/ {
	compatible = "linksys,ea6500-v2", "brcm,bcm4708";
	model = "Linksys EA6500 V2";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
/* bench 4878.2.0 83c74489891b */
/* bench 4878.2.1 cc72a7208c92 */
/* bench 4878.2.2 7222a8a0fb55 */
/* bench 4878.2.3 601aa06723f8 */
/* bench 4878.2.4 3422b2bb1050 */
/* bench 4878.2.5 6e9d1a4f08e5 */
	};

	gpio-keys {
		compatible = "gpio-keys";

		wps {
			label = "WPS";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&chipcommon 7 GPIO_ACTIVE_LOW>;
		};

		restart {
			label = "Reset";
			linux,code = <KEY_RESTART>;
			gpios = <&chipcommon 11 GPIO_ACTIVE_LOW>;
		};
	};
};

&usb3_phy {
	status = "okay";
};
