&reg_dldo2 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
	regulator-name = "vcc-pg";
};

&simplefb_lcd {
	vcc-pg-supply = <&reg_dldo2>;
};
