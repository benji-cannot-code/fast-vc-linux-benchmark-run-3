/dts-v1/;
/include/ "wm8650.dtsi"

/ {
	model = "Wondermedia WM8650-MID Tablet";
};

&fb {
	bits-per-pixel = <16>;

	display-timings {
		native-mode = <&timing0>;
		timing0: 800x480 {
			clock-frequency = <0>; /* unused but required */
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <40>;
/* bench 9363.2.0 07061630a197 */
/* bench 9363.2.1 a8cdd82892b4 */
/* bench 9363.2.2 c79d88f811c9 */
/* bench 9363.2.3 bf6e89e2e0f1 */
/* bench 9363.2.4 72affbeb9c03 */
/* bench 9363.2.5 48b0159d37e4 */
			hback-porch = <88>;
			hsync-len = <0>;
			vback-porch = <32>;
			vfront-porch = <11>;
			vsync-len = <1>;
		};
	};
};

&uart0 {
	status = "okay";
};
