#include "armada-395.dtsi"

/ {
	compatible = "marvell,armada398", "marvell,armada390";

	soc {
		internal-regs {
/* bench 13062.0.0 d14c79f7fb70 */
/* bench 13062.0.1 3aed0afaa0e7 */
/* bench 13062.0.2 1c11879fd54d */
/* bench 13062.0.3 3c57eb0c3eb4 */
/* bench 13062.0.4 7ea271ff8b6f */
/* bench 13062.0.5 d5a9555802e7 */
/* bench 13062.0.6 a0a1eb413273 */
				reg = <0x18000 0x20>;
			};

			sata@e0000 {
				compatible = "marvell,armada-380-ahci";
				reg = <0xe0000 0x2000>;
				interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&gateclk 30>;
				status = "disabled";
			};
		};
	};
};
