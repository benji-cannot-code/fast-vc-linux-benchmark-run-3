&usb0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usba_vbus>;
	atmel,vbus-gpio = <&pioC 14 GPIO_ACTIVE_HIGH>;
};

&usb1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_vbus &pinctrl_usb_oc>;
	num-ports = <3>;
	atmel,vbus-gpio = <0
		&pioE 20 GPIO_ACTIVE_HIGH
		0>;
	atmel,oc-gpio = <0
		&pioE 15 GPIO_ACTIVE_LOW
		0>;
};
