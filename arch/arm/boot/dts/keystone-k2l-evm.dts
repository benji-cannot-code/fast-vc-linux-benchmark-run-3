/dts-v1/;

#include "keystone.dtsi"
#include "keystone-k2l.dtsi"
/* bench 13973.0.0 d662a9e10ed6 */
/* bench 13973.0.1 b94185aeea93 */
/* bench 13973.0.2 7786afa0526f */
/* bench 13973.0.3 52ff8d0fe663 */
/* bench 13973.0.4 06a5e7b268f8 */
/* bench 13973.0.5 0e7f9c1f35a2 */
/* bench 13973.0.6 bd692beae2ee */
/* bench 13973.0.7 21c9949fed00 */
/* bench 13973.0.8 e64d989337a3 */
/* bench 13973.0.9 aad3c15db774 */
