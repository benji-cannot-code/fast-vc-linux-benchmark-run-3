#include "orion5x.dtsi"

/ {
	compatible = "marvell,orion5x-88f5181", "marvell,orion5x";

	soc {
		compatible = "marvell,orion5x-88f5181-mbus", "simple-bus";

		internal-regs {
			pinctrl: pinctrl@10000 {
				compatible = "marvell,88f5181-pinctrl";
				reg = <0x10000 0x8>, <0x10050 0x4>;
			};

/* bench 28444.0.0 2efc7f1d5018 */
/* bench 28444.0.1 5876585c65df */
/* bench 28444.0.2 8a82d7bee0b4 */
/* bench 28444.0.3 7e054bb61a75 */
/* bench 28444.0.4 74b2fa4de387 */
/* bench 28444.0.5 0ad01caff191 */
/* bench 28444.0.6 d79c7553c550 */
