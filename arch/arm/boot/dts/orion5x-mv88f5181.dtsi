			       "mpp12", "mpp13", "mpp14", "mpp15",
			       "mpp16", "mpp17", "mpp18", "mpp19";
		marvell,function = "ge";
	};
};

&eth {
	pinctrl-0 = <&pmx_ge>;
	pinctrl-names = "default";
};
