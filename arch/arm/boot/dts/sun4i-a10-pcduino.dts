&usb_otg {
	dr_mode = "otg";
	status = "okay";
};

&usbphy {
	usb0_id_det-gpios = <&pio 7 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; /* PH4 */
	usb1_vbus-supply = <&reg_vcc5v0>; /* USB1 VBUS is always on */
	usb2_vbus-supply = <&reg_vcc5v0>; /* USB2 VBUS is always on */
	status = "okay";
};
