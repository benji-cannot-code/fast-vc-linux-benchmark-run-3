/include/ "omap4.dtsi"

/ {
	cpus {
		/* OMAP446x 'standard device' variants OPP50 to OPPTurbo */
		cpu@0 {
			operating-points = <
				/* kHz    uV */
				350000  1025000
				700000  1200000
				920000  1313000
			>;
			clock-latency = <300000>; /* From legacy driver */
		};
	};

	pmu {
		compatible = "arm,cortex-a9-pmu";
		interrupts = <0 54 0x4>,
			     <0 55 0x4>;
		ti,hwmods = "debugss";
	};
};
