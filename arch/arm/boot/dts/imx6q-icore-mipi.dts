/dts-v1/;

#include "imx6q.dtsi"
#include "imx6qdl-icore.dtsi"

/ {
	model = "Engicam i.CoreM6 Quad/Dual MIPI Starter Kit";
	compatible = "engicam,imx6-icore", "fsl,imx6q";
};

&hdmi {
	ddc-i2c-bus = <&i2c2>;
	status = "okay";
};

&usdhc3 {
	status = "okay";
};
