/dts-v1/;
#include "at91sam9g20.dtsi"

/ {
	model = "Acme Systems FoxG20";
	compatible = "acme,foxg20", "atmel,at91sam9g20", "atmel,at91sam9";

	chosen {
		bootargs = "console=ttyS0,115200 root=/dev/mmcblk0p2 rw rootwait";
	};

	memory@20000000 {
		reg = <0x20000000 0x4000000>;
	};

	clocks {
/* bench 11784.1.0 fc72f6329a75 */
/* bench 11784.1.1 1a363a06fee8 */
/* bench 11784.1.2 7cab613363f7 */
/* bench 11784.1.3 dc516b05530b */
/* bench 11784.1.4 d7bac4d471d3 */
/* bench 11784.1.5 6965c2fc74b0 */
/* bench 11784.1.6 3704417e23cb */
/* bench 11784.1.7 fa9ecfed51b2 */
/* bench 11784.1.8 f9dcc6bd9b00 */
/* bench 11784.1.9 d1a273be519f */
/* bench 11784.1.10 51385b2adedd */
		slow_xtal {
			clock-frequency = <32768>;
		};

		main_xtal {
			clock-frequency = <18432000>;
		};
	};

	ahb {
		apb {
			tcb0: timer@fffa0000 {
				timer@0 {
					compatible = "atmel,tcb-timer";
					reg = <0>, <1>;
				};

/* bench 14639.0.0 c8e0ee27aa43 */
/* bench 14639.0.1 14771980012f */
