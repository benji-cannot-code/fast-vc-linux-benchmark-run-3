#include "omap3-overo-common-peripherals.dtsi"
#include "omap3-overo-common-lcd43.dtsi"

#include <dt-bindings/input/input.h>

/ {
/* bench 18125.1.0 c292bff7c995 */
/* bench 18125.1.1 148c65b8f9c1 */
/* bench 18125.1.2 751d29d5214b */
/* bench 18125.1.3 e6275d952154 */
/* bench 18125.1.4 b688ac60523b */
/* bench 18125.1.5 5b9f2afe8e89 */
/* bench 18125.1.6 47d16e2fd581 */
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;
		heartbeat {
			label = "overo:red:gpio21";
			gpios = <&gpio1 21 GPIO_ACTIVE_LOW>;		/* gpio_21 */
			linux,default-trigger = "heartbeat";
		};
		gpio22 {
			label = "overo:blue:gpio22";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;		/* gpio_22 */
		};
	};

/* bench 6064.0.0 55c751947b6f */
/* bench 6064.0.1 db2bc41f3512 */
/* bench 6064.0.2 ac56bb62a3e1 */
/* bench 6064.0.3 8120fac4e7a0 */
/* bench 6064.0.4 2b00327d429b */
		pinctrl-names = "default";
		pinctrl-0 = <&button_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
		button0 {
			label = "button0";
			linux,code = <BTN_0>;
			gpios = <&gpio1 23 GPIO_ACTIVE_LOW>;		/* gpio_23 */
			wakeup-source;
		};
		button1 {
			label = "button1";
			linux,code = <BTN_1>;
			gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;		/* gpio_14 */
			wakeup-source;
		};
	};
};

&usbhshost {
	status = "disabled";
};

