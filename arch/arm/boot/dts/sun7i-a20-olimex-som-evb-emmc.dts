/dts-v1/;
#include "sun7i-a20-olimex-som-evb.dts"

/* bench 10337.0.0 f5ea372d7dd1 */
/* bench 10337.0.1 b0d352fea63f */
/* bench 10337.0.2 aa4fcb9f4f2b */
/* bench 10337.0.3 25af2c1139f5 */
/* bench 10337.0.4 c33dc29fccc8 */
	compatible = "olimex,a20-olimex-som-evb-emmc", "allwinner,sun7i-a20";

	mmc2_pwrseq: mmc2_pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&pio 2 18 GPIO_ACTIVE_LOW>;
	};
};

&mmc2 {
	vmmc-supply = <&reg_vcc3v3>;
	mmc-pwrseq = <&mmc2_pwrseq>;
	bus-width = <4>;
	non-removable;
	status = "okay";

	emmc: emmc@0 {
		reg = <0>;
		compatible = "mmc-card";
		broken-hpi;
	};
};
