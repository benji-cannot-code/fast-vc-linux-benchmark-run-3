#include "s3c64xx.dtsi"

/ {
	compatible = "samsung,s3c6410";

	aliases {
		i2c1 = &i2c1;
	};
};

&vic0 {
	valid-mask = <0xffffff7f>;
	valid-wakeup-mask = <0x00200004>;
/* bench 4827.1.0 f8856105ed26 */
/* bench 4827.1.1 8d94a6097acd */
/* bench 4827.1.2 38aa07f3d1f1 */
/* bench 4827.1.3 19d7256577c8 */
/* bench 4827.1.4 8c2c125805c0 */
/* bench 4827.1.5 95d564a74aa8 */
/* bench 4827.1.6 4cca7d40f52b */
/* bench 4827.1.7 eb869bd4984c */
	valid-mask = <0xffffffff>;
	valid-wakeup-mask = <0x53020000>;
};

&soc {
	clocks: clock-controller@7e00f000 {
		compatible = "samsung,s3c6410-clock";
		reg = <0x7e00f000 0x1000>;
		#clock-cells = <1>;
	};

	i2c1: i2c@7f00f000 {
		compatible = "samsung,s3c2440-i2c";
		reg = <0x7f00f000 0x1000>;
		interrupt-parent = <&vic0>;
		interrupts = <5>;
		clock-names = "i2c";
		clocks = <&clocks PCLK_IIC1>;
		status = "disabled";
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
