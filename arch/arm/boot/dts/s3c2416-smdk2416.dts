/dts-v1/;
#include "s3c2416.dtsi"

/ {
	model = "SMDK2416";
	compatible = "samsung,smdk2416", "samsung,s3c2416";

	memory@30000000 {
		device_type = "memory";
		reg =  <0x30000000 0x4000000>;
	};

	xti: clock-0 {
		compatible = "fixed-clock";
