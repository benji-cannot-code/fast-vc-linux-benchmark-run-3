			gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
		};
		orange-usb {
			label = "dns320:orange:usb";
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>; /* GPIO 35 */
		};
	};

	ocp@f1000000 {
		serial@12000 {
			status = "okay";
		};

		serial@12100 {
			status = "okay";
		};
	};
};
