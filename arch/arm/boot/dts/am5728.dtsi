#include "dra74x.dtsi"
#include "am57-pruss.dtsi"

/ {
	compatible = "ti,am5728", "ti,dra7";
};

/*
 * These modules are not present on AM5728
 *
 * EVE1, EVE2
 * ATL
 * VCP1, VCP2
 * MLB
 * ISS
 * USB3, USB4
 */

&usb3_tm {
	status = "disabled";
