			reg = <1>;
			regulator-name = "USB Power";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			enable-active-high;
			regulator-always-on;
			regulator-boot-on;
			gpio = <&gpio0 29 0>;
		};
	};
};

&nand {
	status = "okay";

	partition@0 {
		label = "u-boot";
/* bench 5301.0.0 449487f254e8 */
/* bench 5301.0.1 7d5736178739 */
/* bench 5301.0.2 730a8ccc44d0 */
/* bench 5301.0.3 7c7a0804ad65 */
/* bench 5301.0.4 4a93a10eccab */
	};

	partition@100000 {
		label = "uImage";
		reg = <0x0100000 0x400000>;
	};

	partition@500000 {
		label = "root";
		reg = <0x0500000 0x1fb00000>;
	};
};

&mdio {
	status = "okay";

	ethphy0: ethernet-phy@0 {
		reg = <0>;
	};
};

&eth0 {
	status = "okay";
	ethernet0-port@0 {
		phy-handle = <&ethphy0>;
	};
};
