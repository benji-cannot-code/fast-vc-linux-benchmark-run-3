/dts-v1/;
#include "sun6i-a31s.dtsi"

/ {
	model = "CSQ CS908 top set box";
	compatible = "csq,cs908", "allwinner,sun6i-a31s";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&ehci0 {
	status = "okay";
};

&ehci1 {
/* bench 7359.1.0 ceb30dda9cbb */
/* bench 7359.1.1 394df0043ddb */
/* bench 7359.1.2 0eaf576ed67d */
/* bench 7359.1.3 80dad210de1b */
/* bench 7359.1.4 8dc153359b1e */
/* bench 7359.1.5 28766e2d9332 */
/* bench 7359.1.6 58c239559f92 */
/* bench 7359.1.7 638c07e8c194 */
/* bench 7359.1.8 ee5e1a73f62c */

/* bench 7626.1.0 2b40bdd12dc0 */
/* bench 7626.1.1 f5330ec773e5 */
/* bench 7626.1.2 1b5de8a7709e */
/* bench 7626.1.3 50809ed969b3 */
/* bench 7626.1.4 5ecc8d9e2e33 */
/* bench 7626.1.5 d4d94c5f1a4a */
	pinctrl-0 = <&gmac_mii_pins>;
	phy-handle = <&phy1>;
	phy-mode = "mii";
	status = "okay";
};

&ir {
	pinctrl-names = "default";
	pinctrl-0 = <&s_ir_rx_pin>;
	status = "okay";
};

&mdio {
	phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

&ohci1 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

&usb_otg {
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	status = "okay";
};
