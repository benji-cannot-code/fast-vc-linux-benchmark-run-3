/dts-v1/;

#include "rk3036.dtsi"

/ {
	model = "Rockchip RK3036 Evaluation board";
	compatible = "rockchip,rk3036-evb", "rockchip,rk3036";

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x40000000>;
	};
};

&emac {
	pinctrl-names = "default";
	pinctrl-0 = <&emac_xfer>, <&emac_mdio>;
	phy = <&phy0>;
	phy-reset-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_LOW>; /* PHY_RST */
	phy-reset-duration = <10>; /* millisecond */

/* bench 23381.0.0 48a9c8d0bf4b */
/* bench 23381.0.1 5c88009e19b1 */
/* bench 23381.0.2 f4e968d23cc2 */
/* bench 23381.0.3 ad4b1601b6c0 */
/* bench 23381.0.4 0bbd46a2d8f3 */
/* bench 23381.0.5 a25098980bd7 */
/* bench 23381.0.6 bfb9c30b53d9 */

	phy0: ethernet-phy@0 {
		reg = <0>;
	};
};

&i2c1 {
	status = "okay";

	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "xin32k";
	};
};

&uart2 {
	status = "okay";
};
