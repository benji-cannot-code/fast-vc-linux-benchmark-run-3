/dts-v1/;
/include/ "wm8505.dtsi"

/ {
	model = "Wondermedia WM8505 Netbook";
};

&fb {
/* bench 3812.0.0 cd84a8c314d1 */
/* bench 3812.0.1 51a23cc7959f */
/* bench 3812.0.2 7efa2d89d444 */
/* bench 3812.0.3 d8153f493501 */
/* bench 3812.0.4 b3b11d4f0630 */
/* bench 3812.0.5 829636cb2902 */
/* bench 3812.0.6 06f87c5815ec */
		native-mode = <&timing0>;
		timing0: 800x480 {
			clock-frequency = <0>; /* unused but required */
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <40>;
			hback-porch = <88>;
			hsync-len = <0>;
			vback-porch = <32>;
			vfront-porch = <11>;
			vsync-len = <1>;
		};
	};
};

&uart0 {
	status = "okay";
};
