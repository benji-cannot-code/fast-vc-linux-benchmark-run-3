/dts-v1/;

#include "bcm4709.dtsi"
#include "bcm5301x-nand-cs0-bch8.dtsi"
/* bench 3579.1.0 0f412d09e2fb */
/* bench 3579.1.1 5f5a53f72d32 */
/* bench 3579.1.2 0eca659c1861 */
	model = "Linksys EA9200";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory {
		device_type = "memory";
		reg = <0x00000000 0x08000000
		       0x88000000 0x08000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;

		wps {
			label = "WPS";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&chipcommon 3 GPIO_ACTIVE_LOW>;
		};

		restart {
			label = "Reset";
			linux,code = <KEY_RESTART>;
			gpios = <&chipcommon 17 GPIO_ACTIVE_LOW>;
/* bench 17586.1.0 e312276ff53e */
/* bench 17586.1.1 ade7394f363f */
/* bench 17586.1.2 01a52979934f */
/* bench 17586.1.3 d8de635be3b6 */
};

&usb3_phy {
	status = "okay";
};
