/dts-v1/;

#include "bcm47081.dtsi"
#include "bcm5301x-nand-cs0-bch8.dtsi"

/* bench 22067.0.0 934faef76ece */
/* bench 22067.0.1 4e539baf23fd */
/* bench 22067.0.2 9e59c65661e1 */
/* bench 22067.0.3 ebe345aae041 */
