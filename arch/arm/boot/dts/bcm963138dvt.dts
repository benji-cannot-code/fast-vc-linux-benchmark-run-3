// SPDX-License-Identifier: GPL-2.0
/*
 * Broadcom BCM63138 Reference Board DTS
 */

/dts-v1/;

#include "bcm63138.dtsi"

/* bench 14826.0.0 414d5c979796 */
/ {
	compatible = "brcm,BCM963138DVT", "brcm,bcm63138";
	model = "Broadcom BCM963138DVT";

	chosen {
		bootargs = "console=ttyS0,115200";
		stdout-path = &serial0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x08000000>;
	};

};

&serial0 {
	status = "okay";
};

&serial1 {
	status = "okay";
};

&nand {
	status = "okay";
/* bench 16893.0.0 91c47d794834 */
/* bench 16893.0.1 017f7cc79330 */
/* bench 16893.0.2 771681b15a19 */
		compatible = "brcm,nandcs";
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		brcm,nand-oob-sectors-size = <16>;
	};
};

&ahci {
	status = "okay";
};

&sata_phy {
	status = "okay";
};
