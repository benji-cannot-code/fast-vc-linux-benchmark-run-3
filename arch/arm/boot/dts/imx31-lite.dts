				regulator-boot-on;
			};

			sw2a {		/* 1.8V_DDR, NVCC2, NVCC21 and NVCC22 */
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
/* bench 3090.1.0 d58e059c8510 */
/* bench 3090.1.1 c5b6d88d700c */
/* bench 3090.1.2 6182a8bd060c */
/* bench 3090.1.3 20502fcd17f0 */
/* bench 3090.1.4 edf47892baec */
