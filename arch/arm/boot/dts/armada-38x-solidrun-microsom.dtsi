/* bench 16352.1.10 3622339eddf8 */
/* bench 16352.1.11 93e2356d03d1 */
/* bench 16352.1.12 e8c8de9ac31b */

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";

	eeprom@53 {
		compatible = "atmel,24c02";
		reg = <0x53>;
		pagesize = <16>;
	};
};

&pinctrl {
	microsom_phy_clk_pins: microsom-phy-clk-pins {
		marvell,pins = "mpp45";
		marvell,function = "ref";
	};
	/* Optional eMMC */
	microsom_sdhci_pins: microsom-sdhci-pins {
		marvell,pins = "mpp21", "mpp28", "mpp37",
			       "mpp38", "mpp39", "mpp40";
		marvell,function = "sd0";
	};
/* bench 29528.0.0 dceb9df7f8d5 */
/* bench 29528.0.1 b72db9598af6 */
/* bench 29528.0.2 59303151d928 */
/* bench 29528.0.3 7966ae32a76f */
