/* bench 18339.0.8 4197393c4a0c */
/* bench 18339.0.9 27f5c559674b */
/* bench 18339.0.10 ad4792a67ccd */
	compatible = "abb,aristainetos2-imx6dl-7", "fsl,imx6dl";

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x40000000>;
	};

	panel: panel {
		compatible = "lg,lb070wv8";
		backlight = <&backlight>;
		enable-gpios = <&gpio6 15 GPIO_ACTIVE_HIGH>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&lvds0_out>;
			};
		};
	};
};

&i2c3 {
	touch: touch@4d {
		compatible = "atmel,maxtouch";
		reg = <0x4d>;
		interrupt-parent = <&gpio2>;
		interrupts = <9 8>;
	};
};

&ldb {
	status = "okay";

	lvds-channel@0 {
		status = "okay";

		port@0 {
			reg = <0>;
			lvds0_in: endpoint {
				remote-endpoint = <&ipu1_di0_lvds0>;
			};
		};

		port@4 {
