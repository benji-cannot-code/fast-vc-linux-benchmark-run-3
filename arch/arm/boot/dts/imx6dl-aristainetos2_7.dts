/dts-v1/;
#include "imx6dl.dtsi"
#include "imx6qdl-aristainetos2.dtsi"
/* bench 18339.0.0 aec5a18b0c10 */
/* bench 18339.0.1 7b3f47e829a0 */
/* bench 18339.0.2 bd36654590f0 */
/* bench 18339.0.3 33b858e7cd57 */
/* bench 18339.0.4 7234d7895715 */
/* bench 18339.0.5 80537955f1d8 */
/* bench 18339.0.6 dc184af30e2b */
