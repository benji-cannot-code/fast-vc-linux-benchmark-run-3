/* bench 133.2.10 6b9dec444d58 */
/* bench 133.2.11 246eb9dc772a */
	ethphy0: ethernet-phy@0 {
		reg = <0>;
	};
};

&eth0 {
	status = "okay";
	ethernet0-port@0 {
		phy-handle = <&ethphy0>;
	};
};
