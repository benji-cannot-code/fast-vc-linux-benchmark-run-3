menuconfig ARCH_CLPS711X
	bool "Cirrus Logic EP721x/EP731x-based"
	depends on ARCH_MULTI_V4T
	select CLPS711X_TIMER
	select CPU_ARM720T
	select GPIOLIB
	select MFD_SYSCON
	select OF_IRQ
	help
	  Select this if you use ARMv4T Cirrus Logic chips.
