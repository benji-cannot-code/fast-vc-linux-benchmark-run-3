menuconfig ARCH_RENESAS
	bool "Renesas ARM SoCs"
	depends on ARCH_MULTI_V7 && MMU
	select ARM_GIC
	select GPIOLIB
	select NO_IOPORT_MAP
	select PINCTRL
	select SOC_BUS
	select ZONE_DMA if ARM_LPAE
