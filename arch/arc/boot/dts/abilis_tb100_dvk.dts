/dts-v1/;

/include/ "abilis_tb100.dtsi"

/ {
	model = "abilis,tb100";
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff100000,9600n8 console=ttyS0,9600n8";
	};

	aliases { };

	memory {
		device_type = "memory";
		reg = <0x80000000 0x08000000>;	/* 128M */
	};

	soc100 {
		uart@ff100000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pctl_uart0>;
		};
		ethernet@fe100000 {
			phy-mode = "rgmii";
		};

		i2c0: i2c@ff120000 {
			i2c-sda-hold-time-ns = <432>;
		};
		i2c1: i2c@ff121000 {
			i2c-sda-hold-time-ns = <432>;
		};
		i2c2: i2c@ff122000 {
