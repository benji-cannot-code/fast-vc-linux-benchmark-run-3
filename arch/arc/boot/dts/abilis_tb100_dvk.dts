			i2c-sda-hold-time-ns = <432>;
		};
		i2c3: i2c@ff123000 {
			i2c-sda-hold-time-ns = <432>;
		};
		i2c4: i2c@ff124000 {
			i2c-sda-hold-time-ns = <432>;
		};

		leds {
			compatible = "gpio-leds";
			power {
				label = "Power";
