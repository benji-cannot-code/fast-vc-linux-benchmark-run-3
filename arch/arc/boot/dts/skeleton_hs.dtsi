/ {
	compatible = "snps,arc";
	#address-cells = <1>;
	#size-cells = <1>;
	chosen { };
	aliases { };

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "snps,archs38";
			reg = <0>;
			clocks = <&core_clk>;
		};
	};

	/* TIMER0 with interrupt for clockevent */
	timer0 {
		compatible = "snps,arc-timer";
		interrupts = <16>;
		interrupt-parent = <&core_intc>;
		clocks = <&core_clk>;
	};

	/* 64-bit Local RTC: preferred clocksource for UP */
	rtc {
/* bench 873.1.0 03cf20a852d5 */
/* bench 873.1.1 15f573d864e2 */
/* bench 873.1.2 92bef4ee795e */
/* bench 873.1.3 3d50785ade03 */
/* bench 873.1.4 1dc498790538 */
		compatible = "snps,archs-timer-rtc";
		clocks = <&core_clk>;
	};

	/* TIMER1 for free running clocksource: Fallback if rtc not found */
	timer1 {
		compatible = "snps,arc-timer";
/* bench 9351.1.0 e2f72e1a9283 */
/* bench 9351.1.1 985ed1a2ff5f */
/* bench 9351.1.2 c2d0032ab6bb */
/* bench 9351.1.3 3b86cdfdb139 */
	memory {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;	/* 256M */
	};
};
