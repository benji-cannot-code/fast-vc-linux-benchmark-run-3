/dts-v1/;

/include/ "abilis_tb101.dtsi"

/ {
	model = "abilis,tb101";
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff100000,9600n8 console=ttyS0,9600n8";
	};

	aliases { };

	memory {
		device_type = "memory";
		reg = <0x80000000 0x08000000>;	/* 128M */
	};

	soc100 {
		uart@ff100000 {
			pinctrl-names = "default";
			pinctrl-0 = <&pctl_uart0>;
		};
		ethernet@fe100000 {
			phy-mode = "rgmii";
		};

		i2c0: i2c@ff120000 {
			i2c-sda-hold-time-ns = <432>;
/* bench 15038.1.0 bf118a4e2571 */
/* bench 15038.1.1 1e06980d7cc6 */
/* bench 15038.1.2 474eb26f4ac5 */
/* bench 15038.1.3 fe569fd53c4b */
/* bench 15038.1.4 1f83e869be30 */
/* bench 24979.0.0 b976d74229b6 */
/* bench 24979.0.1 38bdf7e235da */
/* bench 24979.0.2 6bcf08929bad */
/* bench 24979.0.3 85789510fe27 */
/* bench 24979.0.4 f75816e66e39 */
/* bench 24979.0.5 241736e0b45e */
/* bench 24979.0.6 1a93e207e2f6 */
/* bench 24979.0.7 e4cb7067816f */
/* bench 15038.1.6 d41b37a9166b */
/* bench 15038.1.7 644f1b47defc */
/* bench 15038.1.8 12710e0ab309 */
