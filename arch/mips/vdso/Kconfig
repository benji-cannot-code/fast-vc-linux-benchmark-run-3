/* bench 14907.2.7 15ce5e027587 */
/* bench 14907.2.8 b4ef4c7d2b68 */

config MIPS_LD_CAN_LINK_VDSO
	def_bool LD_VERSION >= 22500 || LD_IS_LLD

config MIPS_DISABLE_VDSO
	def_bool CPU_MICROMIPS || (!CPU_MIPSR6 && !MIPS_LD_CAN_LINK_VDSO)
