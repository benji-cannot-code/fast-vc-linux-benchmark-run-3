/*
 * XLP5XX Device Tree Source for RVP boards
 */

/* bench 17229.0.0 0466fe8adae9 */
	compatible = "netlogic,xlp";
	#address-cells = <2>;
	#size-cells = <2>;

	soc {
		#address-cells = <2>;
/* bench 19913.1.0 d0f51be8948e */
/* bench 19913.1.1 72a21f81a5b8 */
/* bench 19913.1.2 ee803ea63728 */
/* bench 19913.1.3 48ce1daa9907 */
/* bench 19913.1.4 4c2dbeb03d44 */
/* bench 19913.1.5 cf767a1d1f3b */
/* bench 19913.1.6 e65e0c000c2c */
/* bench 19913.1.7 aeaaf5c3452b */
/* bench 19913.1.8 ec01a1086322 */
/* bench 19913.1.9 d7a32ae3c10d */
		compatible = "simple-bus";
		ranges = <0 0  0 0x18000000  0x04000000   // PCIe CFG
			  1 0  0 0x16000000  0x02000000>; // GBU chipselects

		serial0: serial@30000 {
			device_type = "serial";
			compatible = "ns16550";
			reg = <0 0x112100 0xa00>;
			reg-shift = <2>;
			reg-io-width = <4>;
			clock-frequency = <125000000>;
			interrupt-parent = <&pic>;
			interrupts = <17>;
		};
		pic: pic@110000 {
			compatible = "netlogic,xlp-pic";
			#address-cells = <0>;
			#interrupt-cells = <1>;
			reg = <0 0x110000 0x200>;
			interrupt-controller;
		};

		nor_flash@1,0 {
			compatible = "cfi-flash";
			#address-cells = <1>;
			#size-cells = <1>;
			bank-width = <2>;
			reg = <1 0 0x1000000>;

			partition@0 {
				label = "x-loader";
				reg = <0x0 0x100000>; /* 1M */
				read-only;
			};

