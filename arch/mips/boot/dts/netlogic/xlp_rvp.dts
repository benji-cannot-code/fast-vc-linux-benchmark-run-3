				label = "u-boot";
				reg = <0x100000 0x100000>; /* 1M */
			};

			partition@200000 {
				label = "kernel";
				reg = <0x200000 0x500000>; /* 5M */
			};

			partition@700000 {
				label = "rootfs";
				reg = <0x700000 0x800000>; /* 8M */
			};

			partition@f00000 {
				label = "env";
				reg = <0xf00000 0x100000>; /* 1M */
				read-only;
			};
		};
