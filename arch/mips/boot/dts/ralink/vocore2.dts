FASTVC-BENCH-CORPUS:linux-main-100k-v1-e0bd41dc-8e12-4f1b-978d-a3645ae59da0
/dts-v1/;

#include "mt7628a.dtsi"

/ {
	compatible = "vocore,vocore2", "ralink,mt7628a-soc";
	model = "VoCore2";

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	chosen {
		bootargs = "console=ttyS2,115200";
		stdout-path = &uart2;
	};
};
