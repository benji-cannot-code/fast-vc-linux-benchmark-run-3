		gpio: pinctrl@70068 {
			compatible = "mscc,luton-pinctrl";
			reg = <0x70068 0x28>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&gpio 0 0 32>;
			interrupt-controller;
			interrupts = <13>;
			#interrupt-cells = <2>;
/* bench 16626.0.0 b169297231d6 */
/* bench 16626.0.1 4286de9a61fd */
