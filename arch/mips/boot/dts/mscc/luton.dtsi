/* bench 16626.0.7 68d966c44693 */
			i2c_pins: i2c-pins {
				pins = "GPIO_5", "GPIO_6";
				function = "twi";
			};

			uart_pins: uart-pins {
				pins = "GPIO_30", "GPIO_31";
				function = "uart";
			};

		};
	};
};
