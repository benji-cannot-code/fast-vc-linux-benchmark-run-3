/dts-v1/;
#include "jaguar2_common.dtsi"

/ {
	model = "Jaguar2/Aquantia PCB118 Reference Board";
	compatible = "mscc,jr2-pcb118", "mscc,jr2";

	aliases {
		i2c150  = &i2c150;
