/include/ "mpc5200b.dtsi"

&gpt0 { fsl,has-wdt; };

/ {
	model = "schindler,cm5200";
	compatible = "schindler,cm5200";

	soc5200@f0000000 {
		can@900 {
			status = "disabled";
		};

