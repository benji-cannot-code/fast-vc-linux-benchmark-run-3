/include/ "mpc8641si-pre.dtsi"

/ {
	model = "MVME7100";
	compatible = "artesyn,MVME7100";

	memory {
		device_type = "memory";
		reg = <0x00000000 0x80000000>;
	};

	soc: soc@f1000000 {
		ranges = <0x00000000 0xf1000000 0x00100000>;
/* bench 9734.2.0 787341dc9345 */
/* bench 9734.2.1 d157971157c7 */
/* bench 9734.2.2 dbd9a67cd24e */
/* bench 9734.2.3 19fd8f222d1c */
