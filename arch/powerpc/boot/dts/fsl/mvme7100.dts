			hwmon@4c {
				compatible = "dallas,max6649";
				reg = <0x4c>;
			};

			rtc@68 {
				status = "disabled";
			};
		};


		enet0: ethernet@24000 {
			phy-handle = <&phy0>;
			phy-connection-type = "rgmii-id";
		};

		mdio@24520 {
			phy0: ethernet-phy@1 {
				reg = <1>;
			};
			phy1: ethernet-phy@2 {
				reg = <2>;
			};
			phy2: ethernet-phy@3 {
				reg = <3>;
			};
			phy3: ethernet-phy@4 {
				reg = <4>;
			};
		};

		enet1: ethernet@25000 {
			phy-handle = <&phy1>;
			phy-connection-type = "rgmii-id";
