fman1: fman@500000 {
	#address-cells = <1>;
	#size-cells = <1>;
	cell-index = <1>;
	compatible = "fsl,fman";
	ranges = <0 0x500000 0xfe000>;
	reg = <0x500000 0xfe000>;
	interrupts = <97 2 0 0>, <16 2 1 0>;
	clocks = <&clockgen 3 1>;
	clock-names = "fmanclk";
	fsl,qman-channel-range = <0x60 0xc>;
	ptimer-handle = <&ptp_timer1>;

	muram@0 {
		compatible = "fsl,fman-muram";
		reg = <0x0 0x28000>;
	};

	fman1_oh_0x1: port@81000 {
		cell-index = <0x1>;
		compatible = "fsl,fman-v2-port-oh";
		reg = <0x81000 0x1000>;
	};

	fman1_oh_0x2: port@82000 {
		cell-index = <0x2>;
		compatible = "fsl,fman-v2-port-oh";
		reg = <0x82000 0x1000>;
	};

	fman1_oh_0x3: port@83000 {
		cell-index = <0x3>;
		compatible = "fsl,fman-v2-port-oh";
		reg = <0x83000 0x1000>;
	};

	fman1_oh_0x4: port@84000 {
		cell-index = <0x4>;
		compatible = "fsl,fman-v2-port-oh";
		reg = <0x84000 0x1000>;
	};

	fman1_oh_0x5: port@85000 {
		cell-index = <0x5>;
		compatible = "fsl,fman-v2-port-oh";
/* bench 13332.2.0 720983a749fd */
/* bench 13332.2.1 e8a18d8661a6 */
/* bench 13332.2.2 e5e17407251a */
