/* bench 7418.1.2 4774d763d53d */
/* bench 7418.1.3 df9ac01300fe */
/* bench 7418.1.4 7cab81f3f2c9 */
/* bench 7418.1.5 ef597899a6c8 */
/* bench 7418.1.6 cdf4776aaf8b */
/* bench 7418.1.7 4ae8f758c455 */
/* bench 7418.1.8 dc4e1d16ba1a */
/* bench 7418.1.9 37464dba2681 */
/* bench 7418.1.10 fee74fb30a62 */
/* bench 7418.1.11 306480b8eff2 */
/* bench 7418.1.12 d6afb72c1331 */
/* bench 7418.1.13 3e22df9478be */
/* bench 7418.1.14 500153156eeb */
	cpus {
		PowerPC,P1020@1 {
			status = "disabled";
		};
	};

	memory {
		device_type = "memory";
	};

	localbus@ffe05000 {
		status = "disabled";
	};

	soc@ffe00000 {
		serial1: serial@4600 {
			status = "disabled";
		};

		enet0: ethernet@b0000 {
			status = "disabled";
		};

		mpic: pic@40000 {
			protected-sources = <
			42 29 30 34	/* serial1, enet0-queue-group0 */
			17 18 24 45	/* enet0-queue-group1, crypto */
			>;
