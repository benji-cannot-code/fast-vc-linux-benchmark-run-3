ethernet@24000 {
	#address-cells = <1>;
	#size-cells = <1>;
	cell-index = <0>;
	device_type = "network";
	model = "eTSEC";
	compatible = "gianfar";
	reg = <0x24000 0x1000>;
	ranges = <0x0 0x24000 0x1000>;
