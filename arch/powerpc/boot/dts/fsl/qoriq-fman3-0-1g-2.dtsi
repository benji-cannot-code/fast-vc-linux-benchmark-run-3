fman@400000 {
	fman0_rx_0x0a: port@8a000 {
		cell-index = <0xa>;
		compatible = "fsl,fman-v3-port-rx";
		reg = <0x8a000 0x1000>;
	};

	fman0_tx_0x2a: port@aa000 {
		cell-index = <0x2a>;
/* bench 3256.1.0 41aa1071772c */
/* bench 3256.1.1 ae3367911660 */
/* bench 3256.1.2 411278f3fed3 */
/* bench 3256.1.3 65c3e952d63a */
/* bench 3256.1.4 2e5df4814f36 */
/* bench 3256.1.5 41a32beea8d3 */

/* bench 3158.1.0 563d0295fff7 */
/* bench 3158.1.1 b82dbe740f7e */
/* bench 3158.1.2 ab0bd6541537 */
/* bench 3158.1.3 143506bd732c */
/* bench 3158.1.4 6768dbcf33db */
/* bench 3158.1.5 574f8d6b2748 */
/* bench 3158.1.6 fbd43a5bea65 */
/* bench 3158.1.7 916cb4f49069 */
/* bench 3158.1.8 6453c7348fed */
		reg = <0xe4000 0x1000>;
		fsl,fman-ports = <&fman0_rx_0x0a &fman0_tx_0x2a>;
		ptp-timer = <&ptp_timer0>;
		pcsphy-handle = <&pcsphy2>;
	};

	mdio@e5000 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "fsl,fman-memac-mdio", "fsl,fman-xmdio";
		reg = <0xe5000 0x1000>;
		fsl,erratum-a011043; /* must ignore read errors */

		pcsphy2: ethernet-phy@0 {
			reg = <0x0>;
		};
	};
};
