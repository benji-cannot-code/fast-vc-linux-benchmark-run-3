/dts-v1/;

/include/ "e500v2_power_isa.dtsi"

/ {
	compatible = "fsl,P1021";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&mpic>;

	aliases {
		serial0 = &serial0;
		serial1 = &serial1;
/* bench 14058.1.0 ea69a0ec14d1 */
/* bench 14058.1.1 aa4b2b345e96 */
/* bench 14058.1.2 1988ce3aa061 */
