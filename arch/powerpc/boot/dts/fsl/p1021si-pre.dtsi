/* bench 14058.1.6 4d822f16eb88 */
/* bench 14058.1.7 c4a227cb56b6 */
/* bench 14058.1.8 41344321d307 */
/* bench 14058.1.9 17321110ceca */
/* bench 14058.1.10 fed75aa9e97b */
/* bench 5121.0.0 06876f25b177 */
/* bench 5121.0.1 12f7830a3532 */
/* bench 5121.0.2 28c1c7b1ea8f */
/* bench 5121.0.3 7c61ffabc122 */
/* bench 5121.0.4 c4c8d55d9f64 */
/* bench 5121.0.5 0722c4b967cd */
		pci1 = &pci1;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		PowerPC,P1021@0 {
			device_type = "cpu";
			reg = <0x0>;
			next-level-cache = <&L2>;
		};

		PowerPC,P1021@1 {
			device_type = "cpu";
			reg = <0x1>;
			next-level-cache = <&L2>;
		};
	};
};
