/* bench 11025.1.10 9724935a5a00 */
/* bench 11025.1.11 83ff7c770c64 */
$CC -c $dir/check-gas-asm.S -o $out
res=$($OBJDUMP -r --section .data $out | fgrep 00004 | tr -s ' ' |cut -f3 -d' ')
rm -f $out
if [ $res != ".text" ]; then
	echo buggy
else
	echo good
fi
