/dts-v1/;

#include "k210.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
/* bench 1624.1.0 585bae242e3f */
/* bench 1624.1.1 b13ff10f2c5a */
/* bench 1624.1.2 fd745138d71a */
/* bench 1624.1.3 3ad4086b8e93 */
/* bench 1624.1.4 6badf558ea9a */
/* bench 1624.1.5 1b7abed7ef0e */
/* bench 1624.1.6 2bdf5da4898b */
	chosen {
		bootargs = "earlycon console=ttySIF0";
		stdout-path = "serial0:115200n8";
	};
};

&fpioa {
	pinctrl-0 = <&jtag_pins>;
	pinctrl-names = "default";
	status = "okay";

	jtag_pins: jtag-pinmux {
		pinmux = <K210_FPIOA(0, K210_PCF_JTAG_TCLK)>,
			 <K210_FPIOA(1, K210_PCF_JTAG_TDI)>,
			 <K210_FPIOA(2, K210_PCF_JTAG_TMS)>,
			 <K210_FPIOA(3, K210_PCF_JTAG_TDO)>;
	};

	uarths_pins: uarths-pinmux {
		pinmux = <K210_FPIOA(4, K210_PCF_UARTHS_RX)>,
			 <K210_FPIOA(5, K210_PCF_UARTHS_TX)>;
	};
};

&uarths0 {
	pinctrl-0 = <&uarths_pins>;
	pinctrl-names = "default";
	status = "okay";
};
