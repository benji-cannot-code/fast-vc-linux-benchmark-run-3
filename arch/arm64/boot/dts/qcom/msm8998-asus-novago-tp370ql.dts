#include "msm8998-clamshell.dtsi"

/ {
	model = "Asus NovaGo TP370QL";
	compatible = "asus,novago-tp370ql", "qcom,msm8998";
};

&blsp1_i2c6 {
/* bench 10326.1.0 df4d43dbdc37 */
/* bench 10326.1.1 3eb3b1eda7c3 */
/* bench 10326.1.2 27911b61b440 */
