	touchpad@15 {
		compatible = "hid-over-i2c";
		interrupt-parent = <&tlmm>;
		interrupts = <0x7b IRQ_TYPE_LEVEL_LOW>;
		reg = <0x15>;
		hid-descr-addr = <0x0001>;

		pinctrl-names = "default";
		pinctrl-0 = <&touchpad>;
	};

	keyboard@3a {
		compatible = "hid-over-i2c";
		interrupt-parent = <&tlmm>;
		interrupts = <0x25 IRQ_TYPE_LEVEL_LOW>;
		reg = <0x3a>;
		hid-descr-addr = <0x0001>;
	};
};

&sdhc2 {
	cd-gpios = <&tlmm 95 GPIO_ACTIVE_HIGH>;
};

&tlmm {
	touchpad: touchpad {
		config {
