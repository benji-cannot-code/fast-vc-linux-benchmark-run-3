			reg = <0x0800>;
		};

		pm8009_gpios: gpio@c000 {
			compatible = "qcom,pm8005-gpio";
			reg = <0xc000>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	pmic@b {
		compatible = "qcom,pm8009", "qcom,spmi-pmic";
		reg = <0xb SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};
