/* bench 9815.1.7 0d2a84ad25ac */
/* bench 9815.1.8 03a1d477c6a5 */
/* bench 9815.1.9 1cf27ea1004c */
/* bench 9815.1.10 5b0514b38e08 */
&reg_ldo_io0 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	regulator-name = "vdd-ctp";
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

&usb_otg {
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	status = "okay";
};
