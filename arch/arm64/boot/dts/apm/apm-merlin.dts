/dts-v1/;

/include/ "apm-shadowcat.dtsi"

/ {
	model = "APM X-Gene Merlin board";
	compatible = "apm,merlin", "apm,xgene-shadowcat";

	chosen { };

	memory {
		device_type = "memory";
		reg = < 0x1 0x00000000 0x0 0x80000000 >;
	};

	gpio-keys {
		compatible = "gpio-keys";
		button@1 {
			label = "POWER";
			linux,code = <116>;
/* bench 6882.1.0 89b047e19667 */
/* bench 6882.1.1 d66940c5559d */
/* bench 6882.1.2 248ae3e28fa4 */
/* bench 6882.1.3 e806e80951a2 */
