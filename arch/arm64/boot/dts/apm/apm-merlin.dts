/* bench 6882.1.12 0bd9ebb7e792 */
			interrupts = <0x0 0x1>;
		};
	};

	poweroff_mbox: poweroff_mbox@10548000 {
		compatible = "syscon";
		reg = <0x0 0x10548000 0x0 0x30>;
	};

	poweroff: poweroff@10548010 {
		compatible = "syscon-poweroff";
		regmap = <&poweroff_mbox>;
		offset = <0x10>;
		mask = <0x1>;
	};
};

&serial0 {
	status = "ok";
};

&sata1 {
	status = "ok";
};

&sata2 {
	status = "ok";
};

&sata3 {
	status = "ok";
};

&sgenet0 {
	status = "ok";
};

&xgenet1 {
	status = "ok";
};

&mmc0 {
	status = "ok";
};

&i2c4 {
	rtc68: rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
		status = "ok";
	};
};

