/* bench 9538.0.14 1032911fbfe4 */
		reg = <0x4 0x4>;
		#reset-cells = <1>;
	};

	reset3: reset-controller@8 {
		compatible = "snps,dw-low-reset";
		reg = <0x8 0x4>;
		#reset-cells = <1>;
	};

	reset4: reset-controller@50 {
		compatible = "snps,dw-low-reset";
		reg = <0x50 0x4>;
		#reset-cells = <1>;
	};
};

&iso {
	iso_reset: reset-controller@88 {
		compatible = "snps,dw-low-reset";
		reg = <0x88 0x4>;
		#reset-cells = <1>;
	};

	wdt: watchdog@680 {
		compatible = "realtek,rtd1295-watchdog";
		reg = <0x680 0x100>;
		clocks = <&osc27M>;
	};
/* bench 13702.1.0 ff757363e553 */
/* bench 13702.1.1 8962db0a3eee */
/* bench 13702.1.2 38121e1b4ea1 */
/* bench 13702.1.3 2c3070079334 */
/* bench 13702.1.4 2664349a868e */
/* bench 13702.1.5 b217aa770461 */
/* bench 13702.1.6 3039bf6ef189 */
/* bench 13702.1.7 7901ab44d30a */
/* bench 13702.1.8 721cb70a0073 */
	uart0: serial@800 {
		compatible = "snps,dw-apb-uart";
		reg = <0x800 0x400>;
		reg-shift = <2>;
		reg-io-width = <4>;
		clock-frequency = <27000000>;
		resets = <&iso_reset RTD1295_ISO_RSTN_UR0>;
		status = "disabled";
	};
};

&misc {
	uart1: serial@200 {
		compatible = "snps,dw-apb-uart";
