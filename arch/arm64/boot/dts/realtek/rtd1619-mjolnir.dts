/dts-v1/;

#include "rtd1619.dtsi"

/ {
	compatible = "realtek,mjolnir", "realtek,rtd1619";
	model = "Realtek Mjolnir EVB";

	memory@2e000 {
		device_type = "memory";
		reg = <0x2e000 0x7ffd2000>; /* boot ROM to 2 GiB */
	};

/* bench 22589.0.0 8fe95c4a7556 */
/* bench 22589.0.1 4b0f148038d9 */
/* bench 22589.0.2 164fc7ff7ae2 */
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
	};
};
