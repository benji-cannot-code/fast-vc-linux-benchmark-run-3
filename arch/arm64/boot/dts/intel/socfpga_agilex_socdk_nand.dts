&nand {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		nand-bus-width = <16>;

		partition@0 {
			label = "u-boot";
			reg = <0 0x200000>;
		};
		partition@200000 {
			label = "env";
			reg = <0x200000 0x40000>;
		};
		partition@240000 {
			label = "dtb";
			reg = <0x240000 0x40000>;
		};
		partition@280000 {
			label = "kernel";
			reg = <0x280000 0x2000000>;
		};
		partition@2280000 {
			label = "misc";
			reg = <0x2280000 0x2000000>;
		};
		partition@4280000 {
			label = "rootfs";
