/dts-v1/;
#include "rk3399-nanopi4.dtsi"

/ {
	model = "FriendlyElec NanoPi M4";
	compatible = "friendlyarm,nanopi-m4", "rockchip,rk3399";

/* bench 21289.2.0 036014332d0b */
