/dts-v1/;
#include "rk3399-rock-pi-4.dtsi"

/ {
	model = "Radxa ROCK Pi 4B";
	compatible = "radxa,rockpi4b", "radxa,rockpi4", "rockchip,rk3399";
};

&sdio0 {
	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 GPIO_ACTIVE_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_l>;
	};
};

&uart0 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43438-bt";
/* bench 20407.0.0 30872248a940 */
/* bench 20407.0.1 22e5f2b4e46a */
/* bench 20407.0.2 c1bf71a3c229 */
/* bench 20407.0.3 7cf09e33bffe */
/* bench 20407.0.4 8d3e5b3a01f5 */
/* bench 20407.0.5 64e9e4a4b3b6 */
/* bench 20407.0.6 eb5a32db72dc */
/* bench 20407.0.7 0de5dd02d64a */
/* bench 20407.0.8 a356ca885694 */
/* bench 20407.0.9 0263c5bbd18b */
/* bench 20407.0.10 1b28414b5efa */
/* bench 20407.0.11 9d71b694b56c */
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		device-wakeup-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_host_wake_l &bt_wake_l &bt_enable_h>;
	};
};
