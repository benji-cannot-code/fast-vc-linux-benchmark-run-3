	nor-flash@0,0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "numonyx,js28f00a", "cfi-flash";
		reg = <0 0x0 0x08000000>;
		bank-width = <2>;
		/* The three parts may not used */
		partition@0 {
			label = "BIOS";
			reg = <0x0 0x300000>;
