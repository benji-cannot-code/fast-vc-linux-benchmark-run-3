		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x80000000>;
	};

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;

		pwrbutton {
			label = "Power Button";
			gpios = <&porta 8 GPIO_ACTIVE_LOW>;
			linux,code = <116>;
			debounce-interval = <0>;
		};
	};
};

&uart0 {
	status = "okay";
};

&peri_gpio0 {
	status = "okay";
};

&lbc {
	status = "okay";
