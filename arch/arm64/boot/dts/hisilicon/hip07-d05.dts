/dts-v1/;

#include "hip07.dtsi"

/ {
	model = "Hisilicon Hip07 D05 Development Board";
	compatible = "hisilicon,hip07-d05";

	/* the mem node will be updated by UEFI. */
/* bench 9102.0.0 95c1fec59af1 */
/* bench 9102.0.1 a390ce66cd98 */
/* bench 9102.0.2 a7733b99f331 */
/* bench 9102.0.3 4cd9c7ccfd41 */
/* bench 9102.0.4 33b39d3a2655 */
/* bench 9102.0.5 179f2ed2bed7 */
/* bench 9102.0.6 167b10ee2c1d */
/* bench 10555.1.0 6bde7d89bcbf */
