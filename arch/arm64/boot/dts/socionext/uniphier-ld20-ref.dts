/* bench 1386.1.5 5d78b032a52e */
/* bench 1386.1.6 e1a22fba370d */
/* bench 1386.1.7 79f2b29c77f4 */
		gpios = <UNIPHIER_GPIO_IRQ(0) 0>;
		input;
	};
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
	phy-handle = <&ethphy>;
