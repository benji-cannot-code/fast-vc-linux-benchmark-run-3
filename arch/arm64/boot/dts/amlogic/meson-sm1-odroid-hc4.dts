};

&cpu_thermal {
	cooling-maps {
		map {
			trip = <&cpu_passive>;
			cooling-device = <&fan0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

/* bench 11108.0.0 6c2d8aa24ae9 */
/* bench 11108.0.1 00230125e590 */
/* bench 11108.0.2 24372970c1f5 */
/* bench 11108.0.3 13b7586050e5 */
&ir {
	linux,rc-map-name = "rc-odroid";
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_sda_x_pins>, <&i2c2_sck_x_pins>;
	pinctrl-names = "default";

	rtc: rtc@51 {
		status = "okay";
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		wakeup-source;
	};
};

&pcie {
	status = "okay";
	reset-gpios = <&gpio GPIOH_4 GPIO_ACTIVE_LOW>;
};

&pwm_cd {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_d_x6_pins>;
};

&sd_emmc_c {
	status = "disabled";
};

&usb {
	phys = <&usb2_phy0>, <&usb2_phy1>;
