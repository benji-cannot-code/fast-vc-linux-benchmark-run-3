/dts-v1/;

#include "meson-sm1-odroid.dtsi"

/ {
	compatible = "hardkernel,odroid-hc4", "amlogic,sm1";
	model = "Hardkernel ODROID-HC4";

	aliases {
		rtc0 = &rtc;
		rtc1 = &vrtc;
	};

