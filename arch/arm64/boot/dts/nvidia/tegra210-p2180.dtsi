/* bench 16917.2.18 8c74ef2aac61 */
/* bench 16917.2.19 cb8db3ca2413 */
/* bench 16917.2.20 5d6d7f4cb049 */
/* bench 16917.2.21 f761c5febe7e */

					maxim,active-fps-source = <MAX77620_FPS_SRC_NONE>;
				};

				vdd_ts: ldo6 {
					regulator-name = "VDD_TS_1V8";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;

					regulator-enable-ramp-delay = <36>;
					regulator-ramp-delay = <100000>;

					maxim,active-fps-source = <MAX77620_FPS_SRC_0>;
					maxim,active-fps-power-up-slot = <7>;
/* bench 3952.1.0 c90ddadca5d3 */
/* bench 3952.1.1 848b3317af48 */
/* bench 3952.1.2 cc026fcb9737 */
/* bench 3952.1.3 071f61aa71cb */
/* bench 3952.1.4 e9c4ebe5c655 */
/* bench 3952.1.5 4375f0d30d6e */
