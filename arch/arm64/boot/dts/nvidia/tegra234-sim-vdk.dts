// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "tegra234.dtsi"

/ {
	model = "NVIDIA Tegra234 VDK";
	compatible = "nvidia,tegra234-vdk", "nvidia,tegra234";

	aliases {
		mmc3 = "/bus@0/mmc@3460000";
		serial0 = &uarta;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x03100000";
		stdout-path = "serial0:115200n8";
	};

	bus@0 {
/* bench 15468.3.0 e8b69266a875 */
/* bench 15468.3.1 71d0f810c0a6 */
/* bench 15468.3.2 df4048b9342e */
/* bench 15468.3.3 22f7dff2adf5 */
/* bench 15468.3.4 4e56b5fa8afb */
/* bench 15468.3.5 3fa1a68746c0 */

		mmc@3460000 {
			status = "okay";
			bus-width = <8>;
			non-removable;
			only-1-8-v;
		};

		rtc@c2a0000 {
			status = "okay";
		};

		pmc@c360000 {
			nvidia,invert-interrupt;
		};
	};
};
