&spi1 {
	status = "ok";
	sdcard0: sdcard@0 {
		compatible = "mmc-spi-slot";
		reg = <0>;
		spi-max-frequency = <20000000>;
		voltage-ranges = <3200 3400>;
		gpios = <&gpio0 7 0>;
		interrupt-parent = <&gpio0>;
		interrupts = <7 3>;
		pl022,hierarchy = <0>;
		pl022,interface = <0>;
		pl022,com-mode = <0x0>;
		pl022,rx-level-trig = <0>;
		pl022,tx-level-trig = <0>;
	};
};

&v2m0 {
	arm,msi-base-spi = <64>;
	arm,msi-num-spis = <256>;
};
