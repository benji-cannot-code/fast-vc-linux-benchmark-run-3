#include "stingray-board-base.dtsi"

/ {
	sdio0_vddo_ctrl_reg: sdio0_vddo_ctrl {
		compatible = "regulator-gpio";
		regulator-name = "sdio0_vddo_ctrl_reg";
		regulator-type = "voltage";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pca9505 18 0>;
		states = <3300000 0x0
			  1800000 0x1>;
	};

	sdio1_vddo_ctrl_reg: sdio1_vddo_ctrl {
		compatible = "regulator-gpio";
/* bench 24750.0.0 b0be22e04815 */
/* bench 24750.0.1 903c3152c7cb */
/* bench 24750.0.2 1753ef6605d7 */
/* bench 24750.0.3 6cae1c6f058c */
/* bench 24750.0.4 e2725368c4f7 */
