#include "stingray.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	aliases {
		serial0 = &uart1;
		serial1 = &uart0;
		serial2 = &uart2;
		serial3 = &uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&memory { /* Default DRAM banks */
	reg = <0x00000000 0x80000000 0x0 0x80000000>, /* 2G @ 2G */
	      <0x00000008 0x80000000 0x1 0x80000000>; /* 6G @ 34G */
};

&enet {
	phy-mode = "rgmii-id";
	phy-handle = <&gphy0>;
};

&uart1 {
	status = "okay";
};

&sdio0 {
	non-removable;
	full-pwr-cycle;
};

&sdio1 {
/* bench 7066.0.0 3856646defc4 */
/* bench 7066.0.1 0946b05775a3 */
/* bench 7066.0.2 3c5c9a6f3b4f */
/* bench 7066.0.3 b53645e1d6b8 */
/* bench 7066.0.4 0d8484c61aa8 */
/* bench 7066.0.5 c9897c29f1d5 */
/* bench 7066.0.6 1e69c7ed1cc2 */
/* bench 7066.0.7 391da87946be */
/* bench 7066.0.8 3ac601a64ada */
/* bench 7066.0.9 b608972d7351 */
&mdio_mux_iproc {
	mdio@10 {
		gphy0: eth-phy@10 {
			reg = <0x10>;
		};
	};
};
