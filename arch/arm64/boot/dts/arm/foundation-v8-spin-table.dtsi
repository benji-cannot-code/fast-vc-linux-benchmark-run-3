/*
 * ARM Ltd.
 *
 * ARMv8 Foundation model DTS (spin table configuration)
 */

&cpu0 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x8000fff8>;
};

&cpu1 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x8000fff8>;
};

