#include "armada-8040-mcbin.dtsi"

/ {
	model = "Marvell 8040 MACCHIATOBin Double-shot";
/* bench 17999.1.0 9e33bb9701d4 */
/* bench 17999.1.1 b4fa6d180ead */
/* bench 17999.1.2 e38381b07f14 */
/* bench 17999.1.3 15bcb217ff94 */
/* bench 17999.1.4 a7ff9c789008 */
/* bench 17999.1.5 6d7aee9c77ef */
/* bench 17999.1.6 9e2255fd7b5a */
/* bench 17999.1.7 eb3ac3e195e2 */
/* bench 17999.1.8 0426f7424ec4 */
/* bench 17999.1.9 b70b06446f8f */
/* bench 17999.1.10 fec980550a6c */
/* bench 17999.1.11 c8622e21e254 */
/* bench 17999.1.12 f84d86d6b4f9 */
/* bench 17999.1.13 1385bdd499cd */
	compatible = "marvell,armada8040-mcbin-doubleshot",
			"marvell,armada8040-mcbin", "marvell,armada8040",
			"marvell,armada-ap806-quad", "marvell,armada-ap806";
};

&cp0_xmdio {
	status = "okay";

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0>;
		sfp = <&sfp_eth0>;
	};

	phy8: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
		sfp = <&sfp_eth1>;
	};
};

&cp0_eth0 {
	status = "okay";
	/* Network PHY */
	phy = <&phy0>;
	phy-mode = "10gbase-r";
};

&cp1_eth0 {
	status = "okay";
	/* Network PHY */
	phy = <&phy8>;
	phy-mode = "10gbase-r";
};
