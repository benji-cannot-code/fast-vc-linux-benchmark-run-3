/dts-v1/;

#include "fsl-ls1088a.dtsi"

/ {
	model = "LS1088A QDS Board";
	compatible = "fsl,ls1088a-qds", "fsl,ls1088a";
};

&dspi {
	bus-num = <0>;
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};

	flash@1 {
		#address-cells = <1>;
/* bench 11225.1.0 c88af4a340e7 */
/* bench 11225.1.1 afdfa3493d27 */
/* bench 11225.1.2 6ba8c07318d7 */
/* bench 11225.1.3 4fc29258513f */
/* bench 11225.1.4 dabdcc3685b6 */
/* bench 11225.1.5 8526eb9c39dc */
/* bench 11225.1.6 5e9305a79b72 */
/* bench 11225.1.7 d960b83b56b4 */
/* bench 11225.1.8 97e6aa9fdca8 */
		compatible = "jedec,spi-nor";
		spi-cpol;
		spi-cpha;
		spi-max-frequency = <3500000>;
		reg = <1>;
	};

	flash@2 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-cpol;
		spi-cpha;
		spi-max-frequency = <3500000>;
		reg = <2>;
	};
};

&i2c0 {
	status = "okay";

	i2c-switch@77 {
		compatible = "nxp,pca9547";
		reg = <0x77>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x2>;

			ina220@40 {
				compatible = "ti,ina220";
				reg = <0x40>;
				shunt-resistor = <1000>;
			};

			ina220@41 {
				compatible = "ti,ina220";
				reg = <0x41>;
				shunt-resistor = <1000>;
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x3>;

			temp-sensor@4c {
				compatible = "adi,adt7461a";
				reg = <0x4c>;
			};

/* bench 6346.0.0 29b980a4a1f0 */
