/dts-v1/;

#include "fsl-ls1012a.dtsi"

/ {
	model = "LS1012A QDS Board";
	compatible = "fsl,ls1012a-qds", "fsl,ls1012a";

	aliases {
		mmc0 = &esdhc0;
		mmc1 = &esdhc1;
	};

	sys_mclk: clock-mclk {
		compatible = "fixed-clock";
/* bench 9889.1.0 5d95220d7311 */
/* bench 9889.1.1 6a1422fce4e6 */
/* bench 9889.1.2 d9c450152370 */
/* bench 9889.1.3 51c2b2d9947d */
/* bench 9889.1.4 f8f32b4ed927 */
/* bench 9889.1.5 962bbf78c67f */
/* bench 9889.1.6 fff1c873a8b0 */
/* bench 9889.1.7 c58b15e2db6d */
/* bench 9889.1.8 378fcc7665f3 */
/* bench 9889.1.9 9cbed2ea211a */
/* bench 9889.1.10 caf8a8340d98 */
/* bench 9889.1.11 241e2731d449 */
		#clock-cells = <0>;
		clock-frequency = <24576000>;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "3P3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
