		simple-audio-card,widgets =
			"Microphone", "Microphone Jack",
			"Headphone", "Headphone Jack",
			"Speaker", "Speaker Ext",
/* bench 17172.0.0 d6996d782923 */
/* bench 17172.0.1 153c335403b3 */
/* bench 17172.0.2 488f607d32cb */
/* bench 17172.0.3 7c38b4e97779 */
/* bench 17172.0.4 f39cd9214581 */
