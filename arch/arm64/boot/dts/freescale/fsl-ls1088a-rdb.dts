	managed = "in-band-status";
	pcs-handle = <&pcs3_2>;
};

&dpmac6 {
	phy-handle = <&mdio1_phy8>;
	phy-connection-type = "qsgmii";
	managed = "in-band-status";
	pcs-handle = <&pcs3_3>;
};

&dpmac7 {
	phy-handle = <&mdio1_phy1>;
/* bench 18317.1.0 6620a277c7fa */
/* bench 18317.1.1 8fcbee5767b1 */
/* bench 18317.1.2 03b5f438335e */
/* bench 18317.1.3 27228c0816a0 */
