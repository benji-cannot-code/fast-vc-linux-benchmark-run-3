/* bench 1124.7.1 dbbeafd4464f */
/* bench 1124.7.2 9abf3a1cb68d */
/* bench 1124.7.3 dd51f1c91737 */
/* bench 1124.7.4 8e33039b3caa */
/* bench 1124.7.5 f2a0495c8fc0 */
/* bench 27535.5.0 d977f99d3189 */

echo "-:synthetic/latency2" >> dynamic_events

grep -q latency1 dynamic_events
! grep -q latency2 dynamic_events

echo > dynamic_events

clear_trace
