/* bench 27465.4.6 04d9a374f88c */
/* bench 27465.4.7 4575a9c2ffb8 */
/* bench 27465.4.8 08b105b94a6e */
echo > kprobe_events
echo "Waiting for unoptimizing & freeing"
sleep 5
echo "Done"
