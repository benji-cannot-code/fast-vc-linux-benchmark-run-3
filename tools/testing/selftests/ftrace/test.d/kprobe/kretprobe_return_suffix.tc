# description: Kretprobe %%return suffix test
# requires: kprobe_events '<symbol>[+<offset>]%return':README

# Test for kretprobe by "r"
echo 'r:myprobeaccept vfs_read' > kprobe_events
RESULT1=`cat kprobe_events`

