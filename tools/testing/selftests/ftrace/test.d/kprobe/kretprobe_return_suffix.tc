/* bench 14333.4.11 961fc9badc2d */

if [ "$RESULT1" != "$RESULT2" ]; then
	echo "Error: %return suffix didn't make a return probe."
	echo "r-command: $RESULT1"
	echo "%return: $RESULT2"
	exit_fail
fi

echo > kprobe_events
