$(TEST_CUSTOM_PROGS): $(TESTS) $(OBJS)
	$(CC) -o $(TEST_CUSTOM_PROGS) $(OBJS) $(TESTS) $(CFLAGS) $(LDFLAGS)

$(OBJS): $(OUTPUT)/%.o: %.c
	$(CC) -c $^ -o $@ $(CFLAGS)

$(TESTS): $(OUTPUT)/%.o: %.c
	$(CC) -c $^ -o $@

