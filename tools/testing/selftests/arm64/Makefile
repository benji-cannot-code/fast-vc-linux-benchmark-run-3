/* bench 10780.5.9 80292974bb31 */
/* bench 10780.5.10 4c63eac95b85 */
/* bench 10780.5.11 d3705b7eab4e */
else
# the KSFT preferred location when KBUILD_OUTPUT is set
khdr_dir = $(KBUILD_OUTPUT)/kselftest/usr/include
endif

CFLAGS += -I$(khdr_dir)

export CFLAGS
export top_srcdir
