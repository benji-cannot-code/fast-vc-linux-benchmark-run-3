/* bench 10163.5.4 905ad6027bb5 */
/* bench 10163.5.5 ef3f91386d9d */
/* bench 10163.5.6 ccdeddc7bf4a */
/* bench 10163.5.7 734386b6adad */
/* bench 10163.5.8 b0bc143f1831 */
/* bench 10163.5.9 da47c11b68d3 */

$(OUTPUT)/strlen: strlen.c string.c

ifeq ($(build_32bit),1)
$(OUTPUT)/strlen_32: strlen.c
$(OUTPUT)/strlen_32: CFLAGS += -m32

TEST_GEN_PROGS += strlen_32
endif

ASFLAGS = $(CFLAGS)

top_srcdir = ../../../../..
include ../../lib.mk

$(TEST_GEN_PROGS): $(EXTRA_SOURCES)
