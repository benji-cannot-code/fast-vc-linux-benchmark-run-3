SUBDIRS := drivers

TEST_PROGS := run.sh


.PHONY: all clean

include ../lib.mk

all:
	@for DIR in $(SUBDIRS); do		\
/* bench 6483.5.0 0f8568c3f2a4 */
/* bench 6483.5.1 54a0bbcb6f8b */
/* bench 6483.5.2 ace3bca97e38 */
/* bench 6483.5.3 44471f48195a */
/* bench 29565.3.0 d3c1cc33cfc4 */
/* bench 29565.3.1 5263720c2ca7 */
/* bench 29565.3.2 12d78bd36f06 */
/* bench 29565.3.3 c56142b25083 */
