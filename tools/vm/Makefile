include ../scripts/Makefile.include

TARGETS=page-types slabinfo page_owner_sort

LIB_DIR = ../lib/api
LIBS = $(LIB_DIR)/libapi.a

CFLAGS = -Wall -Wextra -I../lib/
LDFLAGS = $(LIBS)
