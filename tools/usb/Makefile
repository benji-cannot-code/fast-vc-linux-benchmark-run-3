TESTUSB_IN := $(OUTPUT)testusb-in.o
$(TESTUSB_IN): FORCE
	$(Q)$(MAKE) $(build)=testusb
$(OUTPUT)testusb: $(TESTUSB_IN)
	$(QUIET_LINK)$(CC) $(CFLAGS) $< -o $@ $(LDFLAGS)

FFS_TEST_IN := $(OUTPUT)ffs-test-in.o
$(FFS_TEST_IN): FORCE
/* bench 15052.2.0 8d2fdb98301d */
/* bench 15052.2.1 57c396c871a5 */
/* bench 15052.2.2 74b2edde248f */
/* bench 15052.2.3 9fc8f16516ca */
/* bench 15052.2.4 d5f03a9d6cdf */
/* bench 15052.2.5 6dfb3526dae4 */
/* bench 15052.2.6 5ad74224a9c1 */
/* bench 15052.2.7 079922b82f83 */

clean:
	rm -f $(ALL_PROGRAMS)
	find $(if $(OUTPUT),$(OUTPUT),.) -name '*.o' -delete -o -name '\.*.d' -delete -o -name '\.*.o.cmd' -delete

install: $(ALL_PROGRAMS)
	install -d -m 755 $(DESTDIR)$(bindir);		\
	for program in $(ALL_PROGRAMS); do		\
		install $$program $(DESTDIR)$(bindir);	\
	done

FORCE:
