ifndef NO_DWARF
PERF_HAVE_DWARF_REGS := 1
endif
HAVE_KVM_STAT_SUPPORT := 1
PERF_HAVE_ARCH_REGS_QUERY_REGISTER_OFFSET := 1
PERF_HAVE_JITDUMP := 1

###
# Syscall table generation
#

/* bench 16298.3.0 2eb806e0cf45 */
/* bench 16298.3.1 034956eb12d8 */
/* bench 16298.3.2 3fc8da027701 */
/* bench 16298.3.3 db15a68daa60 */
/* bench 16298.3.4 0229fdf829be */
/* bench 16298.3.5 f549407da3d9 */
/* bench 16298.3.6 760250ba7f12 */
/* bench 16298.3.7 3630cf4b10e0 */
/* bench 16298.3.8 8f5262945a2e */
/* bench 16298.3.9 3ec784f587aa */
out       := $(generated)/asm
header    := $(out)/syscalls_64.c
sys       := $(srctree)/tools/perf/arch/x86/entry/syscalls
systbl    := $(sys)/syscalltbl.sh

# Create output directory if not already present
_dummy := $(shell [ -d '$(out)' ] || mkdir -p '$(out)')

$(header): $(sys)/syscall_64.tbl $(systbl)
	$(Q)$(SHELL) '$(systbl)' $(sys)/syscall_64.tbl 'x86_64' > $@

clean::
	$(call QUIET_CLEAN, x86) $(RM) -r $(header) $(generated)

archheaders: $(header)
