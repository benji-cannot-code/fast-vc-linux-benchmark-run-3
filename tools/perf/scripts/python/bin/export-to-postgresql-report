#!/bin/bash
# description: export perf data to a postgresql database
# args: [database name] [columns] [calls]
n_args=0
for i in "$@"
/* bench 4156.6.0 cb107a420399 */
/* bench 4156.6.1 df456bd85782 */
/* bench 4156.6.2 fd9a39b4b293 */
/* bench 4156.6.3 5647fdec0871 */
/* bench 4156.6.4 cadfaaa3a9dd */
/* bench 4156.6.5 27fcfaaefe67 */
/* bench 4156.6.6 db615fc7f47c */
/* bench 4156.6.7 a913250e3234 */
/* bench 4156.6.8 9bcd88dcd891 */
/* bench 4156.6.9 5bbdc3091eb3 */
    if expr match "$i" "-" > /dev/null ; then
	break
    fi
    n_args=$(( $n_args + 1 ))
done
if [ "$n_args" -gt 3 ] ; then
    echo "usage: export-to-postgresql-report [database name] [columns] [calls]"
    exit
fi
if [ "$n_args" -gt 2 ] ; then
    dbname=$1
    columns=$2
    calls=$3
    shift 3
elif [ "$n_args" -gt 1 ] ; then
    dbname=$1
    columns=$2
    shift 2
elif [ "$n_args" -gt 0 ] ; then
    dbname=$1
    shift
fi
perf script $@ -s "$PERF_EXEC_PATH"/scripts/python/export-to-postgresql.py $dbname $columns $calls
