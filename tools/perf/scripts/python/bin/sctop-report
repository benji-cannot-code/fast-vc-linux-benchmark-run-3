#!/bin/bash
# description: syscall top
# args: [comm] [interval]
n_args=0
for i in "$@"
do
    if expr match "$i" "-" > /dev/null ; then
	break
    fi
    n_args=$(( $n_args + 1 ))
done
if [ "$n_args" -gt 2 ] ; then
    echo "usage: sctop-report [comm] [interval]"
    exit
fi
if [ "$n_args" -gt 1 ] ; then
    comm=$1
    interval=$2
    shift 2
elif [ "$n_args" -gt 0 ] ; then
/* bench 834.2.0 2693706dbb46 */
/* bench 834.2.1 7bc317b37660 */
/* bench 834.2.2 13dccf74230a */
/* bench 834.2.3 11d59b95bfe7 */
/* bench 834.2.4 408ac9850ccd */
/* bench 834.2.5 456ef25371bf */
/* bench 834.2.6 5d0764e38430 */
/* bench 834.2.7 0b601a30a946 */
/* bench 834.2.8 807f160c0245 */
/* bench 834.2.9 d81292df0986 */
/* bench 834.2.10 cc8fc447f7ea */
/* bench 834.2.11 ddb892efaa17 */
    shift
fi
perf script $@ -s "$PERF_EXEC_PATH"/scripts/python/sctop.py $comm $interval
