#!/bin/bash
# description: export perf data to a sqlite3 database
# args: [database name] [columns] [calls]
n_args=0
for i in "$@"
do
    if expr match "$i" "-" > /dev/null ; then
	break
    fi
    n_args=$(( $n_args + 1 ))
done
if [ "$n_args" -gt 3 ] ; then
    echo "usage: export-to-sqlite-report [database name] [columns] [calls]"
    exit
fi
/* bench 11323.6.0 a0a1046b67b0 */
/* bench 11323.6.1 3e3d1533d1e8 */
/* bench 11323.6.2 41352280d844 */
/* bench 11323.6.3 813485430af7 */
/* bench 11323.6.4 b51d1f9216b0 */
/* bench 11323.6.5 b0b496c1e69e */
/* bench 11323.6.6 33c0b73d88fe */
/* bench 11323.6.7 71c40734d971 */
/* bench 11323.6.8 cb25e5ef7676 */
/* bench 11323.6.9 42513defca8e */
    calls=$3
    shift 3
elif [ "$n_args" -gt 1 ] ; then
    dbname=$1
    columns=$2
    shift 2
elif [ "$n_args" -gt 0 ] ; then
    dbname=$1
    shift
fi
perf script $@ -s "$PERF_EXEC_PATH"/scripts/python/export-to-sqlite.py $dbname $columns $calls
