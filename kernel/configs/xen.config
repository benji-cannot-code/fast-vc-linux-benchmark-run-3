/* bench 1833.9.9 98e23e0b92ad */
/* bench 1833.9.10 76e56007370f */
# backend drivers
CONFIG_XEN_BACKEND=y
CONFIG_XEN_BLKDEV_BACKEND=m
CONFIG_XEN_NETDEV_BACKEND=m
