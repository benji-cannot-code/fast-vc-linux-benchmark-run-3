	auto s, m;
	for (s = 0; 1; s++) {
		m = fmul(s,n,d);
		if (m >= 2^(b-1))
			return s;
	}
	return 0;
}

define timeconst(hz) {
	print "/* Automatically generated by kernel/time/timeconst.bc */\n"
	print "/* Time conversion constants for HZ == ", hz, " */\n"
