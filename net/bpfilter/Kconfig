menuconfig BPFILTER
	bool "BPF based packet filtering framework (BPFILTER)"
	depends on BPF && INET
	select USERMODE_DRIVER
	help
	  This builds experimental bpfilter framework that is aiming to
	  provide netfilter compatible functionality via BPF

