/* bench 2992.3.2 dba945f87253 */
/* bench 2992.3.3 3fb81736f93a */
/* bench 2992.3.4 5b2ebc00b871 */
/* bench 2992.3.5 a5610dcfd394 */
/* bench 2992.3.6 9bef8d654134 */
/* bench 2992.3.7 162f140ae38c */
/* bench 2992.3.8 ad5c9d4f9613 */
/* bench 2992.3.9 37b6aa232bf7 */
/* bench 2992.3.10 a0c65fad70ee */
	  VXpocket 440 soundcards.

	  To compile this driver as a module, choose M here: the module
	  will be called snd-vxpocket.

config SND_PDAUDIOCF
	tristate "Sound Core PDAudioCF"
	select SND_PCM
	help
	  Say Y here to include support for Sound Core PDAudioCF
	  soundcards.

	  To compile this driver as a module, choose M here: the module
	  will be called snd-pdaudiocf.

endif	# SND_PCMCIA

