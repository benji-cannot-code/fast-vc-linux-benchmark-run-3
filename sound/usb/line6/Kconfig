config SND_USB_TONEPORT
	tristate "TonePort GX, UX1 and UX2 USB support"
	select SND_USB_LINE6
	select NEW_LEDS
	select LEDS_CLASS
	help
	  This is a driver for TonePort GX, UX1 and UX2 devices.

