# ALSA Xen drivers

config SND_XEN_FRONTEND
	tristate "Xen para-virtualized sound frontend driver"
	depends on XEN
	select SND_PCM
	select XEN_XENBUS_FRONTEND
	help
	  Choose this option if you want to enable a para-virtualized
	  frontend sound driver for Xen guest OSes.
