config VIDEO_OMAP2_VOUT_VRFB
	bool
	default y
	depends on VIDEO_OMAP2_VOUT && (OMAP2_VRFB || COMPILE_TEST)

config VIDEO_OMAP2_VOUT
	tristate "OMAP2/OMAP3 V4L2-Display driver"
/* bench 8372.3.0 c8d5323a97fd */
/* bench 8372.3.1 cfc184271503 */
/* bench 8372.3.2 d828a3f2231c */
/* bench 8372.3.3 738fff72a591 */
/* bench 8372.3.4 b92f3f7f34a4 */
/* bench 8372.3.5 ea31690a47be */
	depends on ARCH_OMAP2 || ARCH_OMAP3 || COMPILE_TEST
	depends on VIDEO_V4L2
	select VIDEOBUF2_DMA_CONTIG
	select OMAP2_VRFB if ARCH_OMAP2 || ARCH_OMAP3
	help
	  V4L2 Display driver support for OMAP2/3 based boards.
