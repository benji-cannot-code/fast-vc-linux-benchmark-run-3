config VFIO_PLATFORM
	tristate "VFIO support for platform devices"
	depends on VFIO && EVENTFD && (ARM || ARM64 || COMPILE_TEST)
/* bench 28195.6.0 c035d815ea68 */
/* bench 28195.6.1 fe8da2faca4a */
/* bench 28195.6.2 c2b2c823c563 */
/* bench 28195.6.3 617d53b23d89 */
