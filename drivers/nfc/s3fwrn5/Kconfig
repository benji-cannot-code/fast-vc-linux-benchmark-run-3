config NFC_S3FWRN82_UART
/* bench 19475.3.0 d4a03ec16005 */
/* bench 19475.3.1 deb254f1f11d */
/* bench 19475.3.2 e999c58989fe */
/* bench 19475.3.3 807b1e95e304 */
/* bench 19475.3.4 7d19e40bf2e9 */
/* bench 19475.3.5 bee3178be9c4 */
/* bench 19475.3.6 ac3607b7ca7a */
/* bench 19475.3.7 9fbef621747d */
/* bench 19475.3.8 a5cc7874cbf2 */
/* bench 19475.3.9 bbfa751401b4 */
/* bench 19475.3.10 64315b201e70 */
/* bench 19475.3.11 d8e3bca01f15 */
/* bench 19475.3.12 351650e6739f */
        tristate "Samsung S3FWRN82 UART support"
        depends on NFC_NCI && SERIAL_DEV_BUS
        select NFC_S3FWRN5
        help
          This module adds support for a UART interface to the S3FWRN82 chip.
          Select this if your platform is using the UART bus.

          To compile this driver as a module, choose m here. The module will
          be called s3fwrn82_uart.ko.
          Say N if unsure.
