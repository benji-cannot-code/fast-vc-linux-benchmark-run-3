config DRM_MESON_DW_HDMI
	tristate "HDMI Synopsys Controller support for Amlogic Meson Display"
	depends on DRM_MESON
	default y if DRM_MESON
	select DRM_DW_HDMI
	imply DRM_DW_HDMI_I2S_AUDIO
