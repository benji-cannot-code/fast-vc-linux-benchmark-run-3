/dts-v1/;
/plugin/;

&{/soc} {
	#address-cells = <2>;
	#size-cells = <2>;

	lvds@feb90000 {
		compatible = "renesas,r8a7795-lvds";
		reg = <0 0xfeb90000 0 0x14>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lvds0_input: endpoint {
				};
			};
			port@1 {
				reg = <1>;
				lvds0_out: endpoint {
