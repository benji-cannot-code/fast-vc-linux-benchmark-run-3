/* bench 18045.3.2 31d7cc0e9f6d */
/* bench 18045.3.3 dddee12caca8 */
/* bench 18045.3.4 22c18222d609 */
/* bench 18045.3.5 0309fdecc04c */
/* bench 18045.3.6 2789778b0916 */

AMD_DAL_DCN301 = $(addprefix $(AMDDALPATH)/dc/dcn301/,$(DCN301))

AMD_DISPLAY_FILES += $(AMD_DAL_DCN301)
