config SCSI_BNX2_ISCSI
	tristate "Broadcom NetXtreme II iSCSI support"
	depends on NET
	depends on PCI
	select SCSI_ISCSI_ATTRS
	select NETDEVICES
	select NETDEV_1000
	select CNIC
	---help---
	This driver supports iSCSI offload for the Broadcom NetXtreme II
	devices.
