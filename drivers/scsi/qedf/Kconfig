config QEDF
	tristate "QLogic QEDF 25/40/100Gb FCoE Initiator Driver Support"
	depends on PCI && SCSI
	depends on QED
        depends on LIBFC
        depends on LIBFCOE
	select QED_LL2
	select QED_FCOE
	---help---
	This driver supports FCoE offload for the QLogic FastLinQ
	41000 Series Converged Network Adapters.
