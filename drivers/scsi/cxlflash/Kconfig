# IBM CXL-attached Flash Accelerator SCSI Driver
#

config CXLFLASH
	tristate "Support for IBM CAPI Flash"
	depends on PCI && SCSI && (CXL || OCXL) && EEH
	select IRQ_POLL
	default m
	help
