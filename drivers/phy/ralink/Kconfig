# PHY drivers for Ralink platforms.
#
config PHY_MT7621_PCI
	tristate "MediaTek MT7621 PCI PHY Driver"
	depends on RALINK && OF
	select GENERIC_PHY
	select REGMAP_MMIO
	help
	  Say 'Y' here to add support for MediaTek MT7621 PCI PHY driver,

