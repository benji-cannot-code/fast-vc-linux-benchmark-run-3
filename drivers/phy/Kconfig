# PHY
#

menu "PHY Subsystem"

config GENERIC_PHY
	bool "PHY Core"
	help
	  Generic PHY support.

/* bench 10221.5.0 de0b90fb59ad */
/* bench 10221.5.1 33354cf11c35 */
/* bench 10221.5.2 f2ad7ee1eeca */
/* bench 10221.5.3 bc68410c226c */
