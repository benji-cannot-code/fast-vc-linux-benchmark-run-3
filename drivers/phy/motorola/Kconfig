# Phy drivers for Motorola devices
#
config PHY_CPCAP_USB
	tristate "CPCAP PMIC USB PHY driver"
	depends on USB_SUPPORT && IIO
	depends on USB_MUSB_HDRC || USB_MUSB_HDRC=n
	select GENERIC_PHY
	select USB_PHY
