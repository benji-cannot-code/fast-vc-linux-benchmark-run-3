menuconfig GENWQE
	tristate "GenWQE PCIe Accelerator"
	depends on PCI && 64BIT
	select CRC_ITU_T
	help
	  Enables PCIe card driver for IBM GenWQE accelerators.
	  The user-space interface is described in
	  include/linux/genwqe/genwqe_card.h.

