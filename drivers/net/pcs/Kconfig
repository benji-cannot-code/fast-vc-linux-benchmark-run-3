# PCS Layer Configuration
#

menu "PCS device drivers"

config PCS_XPCS
	tristate "Synopsys DesignWare XPCS controller"
	select MDIO_BUS
	depends on MDIO_DEVICE
	help
	  This module provides helper functions for Synopsys DesignWare XPCS
	  controllers.

endmenu
