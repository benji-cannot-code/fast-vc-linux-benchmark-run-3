fs_enet-$(CONFIG_FS_ENET_HAS_FCC) += mac-fcc.o

obj-$(CONFIG_FS_ENET_MDIO_FEC) += mii-fec.o
obj-$(CONFIG_FS_ENET_MDIO_FCC) += mii-bitbang.o

