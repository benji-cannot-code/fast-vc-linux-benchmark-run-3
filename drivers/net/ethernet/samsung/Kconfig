/* bench 24464.4.3 294e69148335 */
/* bench 24464.4.4 03e731244862 */
/* bench 24464.4.5 b14480cee17f */

config SXGBE_ETH
	tristate "Samsung 10G/2.5G/1G SXGBE Ethernet driver"
	depends on HAS_IOMEM && HAS_DMA
	select PHYLIB
	select CRC32
