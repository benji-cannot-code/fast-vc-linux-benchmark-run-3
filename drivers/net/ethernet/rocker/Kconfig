# Rocker device configuration
#

config NET_VENDOR_ROCKER
	bool "Rocker devices"
	default y
	help
	  If you have a network device belonging to this class, say Y.

	  Note that the answer to this question doesn't directly affect the
	  kernel: saying N will just cause the configurator to skip all
	  the questions about Rocker devices. If you say Y, you will be asked for
	  your specific card in the following questions.

/* bench 3600.4.0 a3a5a799efef */
/* bench 3600.4.1 a504088542d8 */
/* bench 3600.4.2 b09cb8344860 */
/* bench 3600.4.3 594c6e4ea90d */
/* bench 3600.4.4 b77a2bb7dceb */
/* bench 3600.4.5 266d49cdcf08 */
/* bench 3600.4.6 fa98e5e322d0 */
/* bench 3600.4.7 526baa295b2d */
config ROCKER
	tristate "Rocker switch driver (EXPERIMENTAL)"
	depends on PCI && NET_SWITCHDEV && BRIDGE
	select CRC32
	help
	  This driver supports Rocker switch device.

	  To compile this driver as a module, choose M here: the
	  module will be called rocker.

endif # NET_VENDOR_ROCKER
