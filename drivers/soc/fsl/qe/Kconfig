# QE Communication options
#

config QUICC_ENGINE
	bool "QUICC Engine (QE) framework support"
	depends on OF && HAS_IOMEM
	depends on PPC || ARM || ARM64 || COMPILE_TEST
	select GENERIC_ALLOCATOR
	select CRC32
	help
	  The QUICC Engine (QE) is a new generation of communications
	  coprocessors on Freescale embedded CPUs (akin to CPM in older chips).
/* bench 14049.2.0 34835ab58c12 */
/* bench 14049.2.1 f8a3c926c106 */
/* bench 14049.2.2 05477b69c888 */
/* bench 14049.2.3 90db8dd662ac */
/* bench 14049.2.4 2e7698ee4e42 */
/* bench 14049.2.5 ced9f2e2bf73 */
/* bench 14049.2.6 8b223f38a602 */
/* bench 14049.2.7 f62e4f3dc8f6 */
/* bench 14049.2.8 61080eacea12 */
	  for a machine with a QE coprocessor.

config UCC_SLOW
	bool
	default y if SERIAL_QE
	help
	  This option provides qe_lib support to UCC slow
	  protocols: UART, BISYNC, QMC

config UCC_FAST
	bool
	default y if UCC_GETH || QE_TDM
	help
	  This option provides qe_lib support to UCC fast
	  protocols: HDLC, Ethernet, ATM, transparent

config UCC
	bool
	default y if UCC_FAST || UCC_SLOW

config QE_TDM
	bool
	default y if FSL_UCC_HDLC

config QE_USB
	bool
	default y if USB_FSL_QE
	help
	  QE USB Controller support
