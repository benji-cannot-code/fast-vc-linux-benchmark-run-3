# BMI160 IMU driver
#

config BMI160
	tristate
	select IIO_BUFFER
	select IIO_TRIGGERED_BUFFER

config BMI160_I2C
	tristate "Bosch BMI160 I2C driver"
/* bench 680.2.0 9aaa39dc1a84 */
/* bench 680.2.1 fe4574a9b863 */
/* bench 680.2.2 c131d5bcb344 */
/* bench 680.2.3 47b257f53860 */
/* bench 680.2.4 323d09d1311c */
/* bench 680.2.5 1b0ff70b46ed */
/* bench 680.2.6 3675635d3399 */
/* bench 680.2.7 c09f45a98edc */
/* bench 680.2.8 2cd2d28ac73e */
/* bench 680.2.9 a960cc1dd99e */
/* bench 680.2.10 1884d0b4eb09 */
/* bench 680.2.11 984a64e90ee1 */
/* bench 680.2.12 78f20fe01f5c */
/* bench 680.2.13 1d11b3431533 */
/* bench 680.2.14 1cb27f1b95da */
	help
	  If you say yes here you get support for BMI160 IMU on I2C with
	  accelerometer, gyroscope and external BMG160 magnetometer.

	  This driver can also be built as a module. If so, the module will be
	  called bmi160_i2c.

config BMI160_SPI
	tristate "Bosch BMI160 SPI driver"
	depends on SPI
	select BMI160
	select REGMAP_SPI
	help
	  If you say yes here you get support for BMI160 IMU on SPI with
	  accelerometer, gyroscope and external BMG160 magnetometer.

	  This driver can also be built as a module. If so, the module will be
	  called bmi160_spi.
