# common clock support for NXP i.MX SoC family.
config MXC_CLK
	tristate "IMX clock"
	depends on ARCH_MXC || COMPILE_TEST

config MXC_CLK_SCU
	tristate

config CLK_IMX1
	def_bool SOC_IMX1
	select MXC_CLK

config CLK_IMX25
	def_bool SOC_IMX25
	select MXC_CLK

