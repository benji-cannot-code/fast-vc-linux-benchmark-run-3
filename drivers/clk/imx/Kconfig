config CLK_IMX8QXP
	tristate "IMX8QXP SCU Clock"
	depends on (ARCH_MXC && ARM64) || COMPILE_TEST
	depends on IMX_SCU && HAVE_ARM_SMCCC
	select MXC_CLK_SCU
