ssb-y					+= driver_chipcommon_pmu.o
ssb-$(CONFIG_SSB_SFLASH)		+= driver_chipcommon_sflash.o
ssb-$(CONFIG_SSB_DRIVER_MIPS)		+= driver_mipscore.o
ssb-$(CONFIG_SSB_DRIVER_EXTIF)		+= driver_extif.o
