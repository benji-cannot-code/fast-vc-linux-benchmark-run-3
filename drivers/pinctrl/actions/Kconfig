config PINCTRL_OWL
	bool "Actions Semi OWL pinctrl driver"
	depends on (ARCH_ACTIONS || COMPILE_TEST) && OF
	select PINMUX
	select PINCONF
	select GENERIC_PINCONF
	select GPIOLIB
	select GPIOLIB_IRQCHIP
	help
	  Say Y here to enable Actions Semi OWL pinctrl driver

