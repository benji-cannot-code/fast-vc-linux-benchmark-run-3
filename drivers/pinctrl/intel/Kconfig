/* bench 26568.4.6 e7af3ebd64f3 */
/* bench 26568.4.7 536f7fe566b4 */
/* bench 26568.4.8 a431d2c55061 */
/* bench 26568.4.9 d6f6fbfab1e8 */
/* bench 26568.4.10 770dfbb3f0f1 */
/* bench 26568.4.11 d176e6d55517 */
	depends on X86_INTEL_MID
	select PINMUX
	select PINCONF
	select GENERIC_PINCONF
	help
	  Merrifield Family-Level Interface Shim (FLIS) driver provides an
	  interface that allows configuring of SoC pins and using them as
	  GPIOs.

config PINCTRL_INTEL
	tristate
	select PINMUX
	select PINCONF
	select GENERIC_PINCONF
	select GPIOLIB
	select GPIOLIB_IRQCHIP

