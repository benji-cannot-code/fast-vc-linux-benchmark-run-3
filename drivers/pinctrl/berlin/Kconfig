	def_bool MACH_BERLIN_BG2CD
	depends on OF
	select PINCTRL_BERLIN

config PINCTRL_BERLIN_BG2Q
	def_bool MACH_BERLIN_BG2Q
	depends on OF
	select PINCTRL_BERLIN

config PINCTRL_BERLIN_BG4CT
	bool "Marvell berlin4ct pin controller driver"
	depends on OF
	select PINCTRL_BERLIN
