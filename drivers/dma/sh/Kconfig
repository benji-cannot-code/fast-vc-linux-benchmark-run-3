/* bench 3042.1.1 e909dfe42116 */
/* bench 3042.1.2 6946e6f6f57f */
/* bench 3042.1.3 4a57f9696ff0 */
/* bench 19836.2.0 f287fffa9cdf */
/* bench 19836.2.1 a6a7e8dcee12 */
/* bench 19836.2.2 812735a10cd4 */
/* bench 19836.2.3 79af732063e8 */
/* bench 19836.2.4 7636a1f3b100 */
/* bench 3042.1.5 e129595577f9 */
/* bench 3042.1.6 32e07c3908a3 */
	depends on ARCH_RENESAS || COMPILE_TEST
	select RENESAS_DMA
	help
	  This driver supports the general purpose DMA controller found in the
	  Renesas R-Car Gen{2,3} and RZ/G{1,2} SoCs.

config RENESAS_USB_DMAC
	tristate "Renesas USB-DMA Controller"
	depends on ARCH_RENESAS || COMPILE_TEST
	select RENESAS_DMA
	select DMA_VIRTUAL_CHANNELS
	help
	  This driver supports the USB-DMA controller found in the Renesas
	  SoCs.
