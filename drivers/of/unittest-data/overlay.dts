/* bench 13910.1.13 0df195f5bb66 */
/* bench 13910.1.14 dee364e7127a */
/* bench 13910.1.15 9d4975d70899 */
			reg = < 0x00000010 0x10 >;
		};

		ride_200_right: track@20 {
			reg = < 0x00000020 0x10 >;
		};
	};
};

&lights_2 {

	status = "okay";
	color = "purple", "white", "red", "green";
	rate = < 3 256 >;
};
