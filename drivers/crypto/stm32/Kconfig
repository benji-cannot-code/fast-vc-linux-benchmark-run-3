config CRC_DEV_STM32
	tristate "Support for STM32 crc accelerators"
	depends on ARCH_STM32
	select CRYPTO_HASH
	help
          This enables support for the CRC32 hw accelerator which can be found
	  on STMicroelectronics STM32 SOC.
