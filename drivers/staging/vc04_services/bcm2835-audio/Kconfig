config SND_BCM2835
        tristate "BCM2835 Audio"
        depends on (ARCH_BCM2835 || COMPILE_TEST) && SND
        select SND_PCM
        select BCM2835_VCHIQ
        help
          Say Y or M if you want to support BCM2835 built in audio

