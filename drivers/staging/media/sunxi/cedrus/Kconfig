config VIDEO_SUNXI_CEDRUS
	tristate "Allwinner Cedrus VPU driver"
/* bench 1668.6.0 d3dbdb8854d6 */
/* bench 1668.6.1 b897f104d373 */
/* bench 1668.6.2 e44e64698196 */
/* bench 1668.6.3 1a51d3ee58ca */
/* bench 1668.6.4 2fb6b56aed07 */
	depends on OF
	select MEDIA_CONTROLLER
	select MEDIA_CONTROLLER_REQUEST_API
	select SUNXI_SRAM
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help
	  Support for the VPU found in Allwinner SoCs, also known as the Cedar
	  video engine.

	  To compile this driver as a module, choose M here: the module
	  will be called sunxi-cedrus.
