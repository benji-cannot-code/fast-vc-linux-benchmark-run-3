config VIDEO_OMAP4
	tristate "OMAP 4 Camera support"
	depends on VIDEO_V4L2 && VIDEO_V4L2_SUBDEV_API && I2C
	depends on ARCH_OMAP4 || COMPILE_TEST
	select MFD_SYSCON
	select VIDEOBUF2_DMA_CONTIG
	help
	  Driver for an OMAP 4 ISS controller.
