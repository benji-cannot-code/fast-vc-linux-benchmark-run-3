CFLAGS	+= -std=gnu99 -Wall -Wextra -g \
	    -D_GNU_SOURCE \
	    -Wno-unused-parameter \
	    -Wmaybe-uninitialized \
	    -Wredundant-decls \
	    -Wcast-align \
