CC	:= $(CROSS_COMPILE)gcc

TOOLS = loopback_test

all: $(TOOLS)

%.o: %.c ../greybus_protocols.h
	@echo '  TARGET_CC $@'
	$(Q)$(CC) $(CFLAGS) -c $< -o $@

loopback_%: loopback_%.o
	@echo '  TARGET_LD $@'
	$(Q)$(CC) $(CFLAGS) $(LDFLAGS) $^ -o $@

clean::
	rm -f *.o $(TOOLS)
