FASTVC-BENCH-CORPUS:linux-main-100k-v1-e0bd41dc-8e12-4f1b-978d-a3645ae59da0
#!/usr/bin/env ktap

s = aggr_table()

trace syscalls:sys_enter_* {
	s[execname()] = count()
}

trace_end {
	histogram(s)
}

print("Press Control-C to stop.")

