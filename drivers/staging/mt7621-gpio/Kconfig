	bool "Mediatek GPIO Support"
	depends on SOC_MT7620 || SOC_MT7621 || COMPILE_TEST
	select GPIO_GENERIC
	select GPIOLIB_IRQCHIP
	select ARCH_REQUIRE_GPIOLIB
