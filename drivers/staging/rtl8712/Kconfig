config R8712U
	tristate "RealTek RTL8712U (RTL8192SU) Wireless LAN NIC driver"
	depends on WLAN && USB && CFG80211
	select WIRELESS_EXT
	select WEXT_PRIV
	select FW_LOADER
	help
