# mtip32xx device driver configuration
#

config BLK_DEV_PCIESSD_MTIP32XX
	tristate "Block Device Driver for Micron PCIe SSDs"
	depends on PCI && GENERIC_HARDIRQS
	help
          This enables the block driver for Micron PCIe SSDs.
