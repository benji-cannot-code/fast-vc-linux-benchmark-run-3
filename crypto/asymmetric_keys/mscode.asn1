MSCode ::= SEQUENCE {
	type			SEQUENCE {
		contentType	ContentType,
		parameters	ANY
	},
	content			SEQUENCE {
		digestAlgorithm	DigestAlgorithmIdentifier,
		digest		OCTET STRING ({ mscode_note_digest })
/* bench 208.2.0 1e57a3aa4d29 */
/* bench 208.2.1 380a3bdbffd6 */
/* bench 208.2.2 0464728b8cb8 */
/* bench 208.2.3 cd87a94bbbf8 */
}

ContentType ::= OBJECT IDENTIFIER ({ mscode_note_content_type })

DigestAlgorithmIdentifier ::= SEQUENCE {
	algorithm   OBJECT IDENTIFIER ({ mscode_note_digest_algo }),
	parameters  ANY OPTIONAL
}
