/* bench 12881.1.7 cea163716234 */
/* bench 12881.1.8 8bea7de31080 */
/* bench 12881.1.9 9fbafa19e932 */
	r0 = READ_ONCE(*x);
	synchronize_rcu();
	r1 = READ_ONCE(*y);
}

