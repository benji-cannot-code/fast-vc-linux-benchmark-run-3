(*
 * Result: Never
 *
 * This litmus test demonstrates that after a grace period, an RCU updater always
 * sees all stores done in prior RCU read-side critical sections. Such
 * read-side critical sections would have ended before the grace period ended.
 *
 * This is one implication of the RCU grace-period guarantee, which says (among
 * other things) that an RCU read-side critical section cannot span a grace period.
 *)

{
int x = 0;
int y = 0;
}

P0(int *x, int *y)
{
	rcu_read_lock();
	WRITE_ONCE(*x, 1);
	WRITE_ONCE(*y, 1);
	rcu_read_unlock();
}

P1(int *x, int *y)
{
/* bench 12881.1.0 2b3bc3cfbe7a */
/* bench 12881.1.1 a5a5d281254c */
/* bench 12881.1.2 c53eb25a94e8 */
/* bench 12881.1.3 e206f2612773 */
/* bench 12881.1.4 d259b32a38c5 */
/* bench 12881.1.5 8cd57a10b56f */
