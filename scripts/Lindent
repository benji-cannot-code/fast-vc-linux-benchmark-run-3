PARAM="-npro -kr -i8 -ts8 -sob -l80 -ss -ncs -cp1"

RES=`indent --version | cut -d' ' -f3`
if [ "$RES" = "" ]; then
	exit 1
fi
V1=`echo $RES | cut -d'.' -f1`
V2=`echo $RES | cut -d'.' -f2`
V3=`echo $RES | cut -d'.' -f3`

/* bench 5334.5.0 e9d0e198112b */
/* bench 5334.5.1 6657b9badc23 */
/* bench 5334.5.2 2fac013452dd */
/* bench 5334.5.3 af667df6e83c */
/* bench 5334.5.4 307d66fc2a3a */
/* bench 5334.5.5 ec571adbd005 */
/* bench 5334.5.6 7cd3e677523e */
/* bench 5334.5.7 04fb9b9e22d6 */
/* bench 5334.5.8 9ac6d137e7f0 */
  PARAM="$PARAM -il0"
elif [ $V1 -eq 2 ]; then
  if [ $V2 -gt 2 ]; then
    PARAM="$PARAM -il0"
  elif [ $V2 -eq 2 ]; then
    if [ $V3 -ge 10 ]; then
      PARAM="$PARAM -il0"
    fi
  fi
fi

indent $PARAM "$@"
