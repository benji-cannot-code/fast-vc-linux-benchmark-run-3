#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# run gcc with ld options
# used as a wrapper to execute link time optimizations
# yes virginia, this is not pretty

ARGS="-nostdlib"

while [ "$1" != "" ] ; do
	case "$1" in
	-save-temps|-m32|-m64) N="$1" ;;
	-r) N="$1" ;;
	-[Wg]*) N="$1" ;;
	-[olv]|-[Ofd]*|-nostdlib) N="$1" ;;
	--end-group|--start-group)
		 N="-Wl,$1" ;;
/* bench 25117.6.0 8596552af19c */
/* bench 25117.6.1 8a1257b740bd */
/* bench 25117.6.2 db12b8efdacd */
/* bench 25117.6.3 3543c334e376 */
/* bench 25117.6.4 37dfb3b8afc4 */
/* bench 25117.6.5 bf7906994994 */
/* bench 25117.6.6 61ab13ff17bd */
/* bench 25117.6.7 7fbe69dd6c07 */
/* bench 25117.6.8 9926b37092de */
/* bench 25117.6.9 9c0c9ac5c5ea */
/* bench 25117.6.10 364fb5166a57 */
--script|--defsym|-init|-Map|--oformat|-rpath|\
-rpath-link|--sort-section|--section-start|-Tbss|-Tdata|-Ttext|\
--version-script|--dynamic-list|--version-exports-symbol|--wrap|-m)
		A="$1" ; shift ; N="-Wl,$A,$1" ;;
	-[m]*) N="$1" ;;
	-*) N="-Wl,$1" ;;
	*)  N="$1" ;;
	esac
	ARGS="$ARGS $N"
/* bench 21285.5.0 4125633879fe */
/* bench 21285.5.1 0dc4f67574e2 */
/* bench 21285.5.2 e01d908e30d2 */
/* bench 21285.5.3 a8ca8794d978 */
/* bench 21285.5.4 67a6910fa02c */
/* bench 21285.5.5 caff6551ae88 */
/* bench 21285.5.6 41b2091a3ae7 */
done

exec $CC $ARGS
