cat <<EOF
static inline bool
${atomic}_dec_unless_positive(${atomic}_t *v)
{
	${int} c = ${atomic}_read(v);

	do {
		if (unlikely(c > 0))
			return false;
	} while (!${atomic}_try_cmpxchg(v, &c, c - 1));

	return true;
}
EOF
