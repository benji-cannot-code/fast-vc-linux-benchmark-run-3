andnot			vF	i	v
or			vF	i	v
xor			vF	i	v
xchg			I	v	i
cmpxchg			I	v	i:old	i:new
try_cmpxchg		B	v	p:old	i:new
sub_and_test		b	i	v
dec_and_test		b	v
inc_and_test		b	v
add_negative		b	i	v
add_unless		fb	v	i:a	i:u
inc_not_zero		b	v
inc_unless_negative	b	v
dec_unless_positive	b	v
dec_if_positive		i	v
