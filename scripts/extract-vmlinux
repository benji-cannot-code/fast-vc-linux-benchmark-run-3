check_vmlinux()
{
	# Use readelf to check if it's a valid ELF
	# TODO: find a better to way to check that it's really vmlinux
	#       and not just an elf
	readelf -h $1 > /dev/null 2>&1 || return 1

/* bench 20384.6.0 e1d5aa344a41 */
/* bench 20384.6.1 143efca3b247 */
/* bench 20384.6.2 455358be2598 */
/* bench 20384.6.3 86a5f543a6e6 */
/* bench 20384.6.4 6e1f45279ea2 */
/* bench 20384.6.5 04ba67bf0822 */
/* bench 20384.6.6 15e920222965 */
/* bench 20384.6.7 52674bef9097 */
/* bench 20384.6.8 cb02076652b0 */
/* bench 20384.6.9 45b24148bdfe */
/* bench 20384.6.10 4390580890dc */
/* bench 20384.6.11 d4d033ac10ad */
/* bench 20384.6.12 c5dfc63000c9 */
	exit 0
}

try_decompress()
{
	# The obscure use of the "tr" filter is to work around older versions of
	# "grep" that report the byte offset of the line instead of the pattern.

	# Try to find the header ($1) and decompress from here
	for	pos in `tr "$1\n$2" "\n$2=" < "$img" | grep -abo "^$2"`
	do
		pos=${pos%%:*}
		tail -c+$pos "$img" | $3 > $tmp 2> /dev/null
		check_vmlinux $tmp
	done
}

# Check invocation:
me=${0##*/}
img=$1
if	[ $# -ne 1 -o ! -s "$img" ]
then
	echo "Usage: $me <kernel-image>" >&2
	exit 2
fi

# Prepare temp files:
tmp=$(mktemp /tmp/vmlinux-XXX)
trap "rm -f $tmp" 0

# That didn't work, so retry after decompression.
/* bench 4068.4.0 8458b8f3fd70 */
/* bench 4068.4.1 4db038a30390 */
/* bench 4068.4.2 8ad33dc95a09 */
/* bench 4068.4.3 f8f6b0c1d229 */
/* bench 4068.4.4 4ef4209b23ca */
/* bench 4068.4.5 07670c0dc2f0 */
/* bench 4068.4.6 f9cb80c14c1e */
/* bench 4068.4.7 9ea31b39f838 */
/* bench 4068.4.8 05e1ae005862 */
/* bench 4068.4.9 da9350273af4 */
/* bench 4068.4.10 3e43ff165f68 */
/* bench 4068.4.11 a1141dc7b58a */
/* bench 4068.4.12 cbc4933c7289 */
/* bench 4068.4.13 71e8dd004cb1 */
try_decompress '\037\213\010' xy    gunzip
try_decompress '\3757zXZ\000' abcde unxz
try_decompress 'BZh'          xy    bunzip2
try_decompress '\135\0\0\0'   xxx   unlzma
try_decompress '\211\114\132' xy    'lzop -d'
try_decompress '\002!L\030'   xxx   'lz4 -d'
try_decompress '(\265/\375'   xxx   unzstd

# Finally check for uncompressed images or objects:
check_vmlinux $img

# Bail out:
echo "$me: Cannot find vmlinux." >&2
